for k, (x0g, dirg, dg, ur) in enumerate(((X1, 1, 0.27, 3), (FS1, 1, 0.30, 2), (X0 - 0.003, -1, 0.07, 3))):
    g = Part(f"EXT-HX-GASKET-{k+1}", "Gasket / O-ring flens tutup heat exchanger", "HX", RUB, "ILLUSTRATIVE", "ILLUSTRATIVE (tidak terlihat di foto)", "tebal 3 mm ILLUSTRATIVE")
    rect_ring(g, x0g, x0g + 0.003, FY0 + 0.004, FY1 - 0.004, FZ - 0.004, IY0, IY1, IZ)
    g.finish()
    asm_pos("EXT-HX", 5, f"EXT-HX-GASKET-{k+1}", (dirg, 0, 0), dg, ur)
# 6 baut tutup (satu nomor, banyak posisi)
asm_part("EXT-HX", 6, "Baut flens tutup (hex bolt dengan ring)", "ILLUSTRATIVE", "P23 (baut di tepi muka depan terlihat); jumlah dan ukuran ILLUSTRATIVE",
         "menjepit tutup, gasket, dan tube sheet ke flens shell")
bpos = [(yy, -0.48 + 0.16 * i) for yy in (0.56, 0.92) for i in range(7)] + [(yy, sg * 0.525) for sg in (1, -1) for yy in (0.66, 0.74, 0.82)]
nb_ = 0
for side, (xh, d_) in (("D", (2.380, 1)), ("B", (2.135, -1))):
    for (yy, zz) in bpos:
        nb_ += 1
        b_ = Part(f"EXT-HX-BAUT-{nb_}", f"Baut flens tutup {'depan' if d_ > 0 else 'belakang'}", "HX", STL, "ILLUSTRATIVE", "P23 (baut tepi depan)", "M12 x 50 ILLUSTRATIVE")
        b_.cyl((xh + d_ * 0.006, yy, zz), (d_, 0, 0), 0.0115, 0.012, n=6)                # kepala hex
        b_.cyl((xh + d_ * 0.0005, yy, zz), (d_, 0, 0), 0.013, 0.001, n=16)              # ring
        L_ = abs(xh - (X1 - 0.012 if d_ > 0 else X0 + 0.012))
        b_.cyl((xh - d_ * L_ / 2, yy, zz), (d_, 0, 0), 0.006, L_, n=10)                  # batang ke flens shell
        b_.finish()
        asm_pos("EXT-HX", 6, f"EXT-HX-BAUT-{nb_}", (d_, 0, 0), 0.45 if d_ > 0 else 0.30, 1)
# 7 plug drain/vent (satu nomor, tiga posisi)
asm_part("EXT-HX", 7, "Plug drain / vent", "ILLUSTRATIVE", "tidak terlihat di foto; plug pembuangan dan ventilasi umum pada heat exchanger",
         "membuang air saat perawatan dan membuang udara terperangkap saat pengisian")
for k, (c_, d_, dist) in enumerate((((2.25, BY0, -0.25), (0, -1, 0), 0.08), ((2.386, 0.86, 0.36), (1, 0, 0), 0.40), ((2.126, 0.60, 0.30), (0, -1, 0), 0.08))):
    pg = Part(f"EXT-HX-PLUG-{k+1}", "Plug drain / vent heat exchanger", "HX", STL, "ILLUSTRATIVE", "ILLUSTRATIVE", "ukuran ILLUSTRATIVE")
    c_ = V(c_); d_ = V(d_)
    pg.cyl(c_ + d_ * 0.006, d_, 0.012, 0.012, n=6)
    pg.cyl(c_ - d_ * 0.008, d_, 0.008, 0.016, n=10)
    pg.finish()
    asm_pos("EXT-HX", 7, f"EXT-HX-PLUG-{k+1}", d_, dist, 1)
# 8 anoda seng
asm_part("EXT-HX", 8, "Anoda seng (zinc anode) dengan sumbat berulir", "ILLUSTRATIVE", "tidak terlihat di foto; lazim pada heat exchanger berpendingin air laut",
