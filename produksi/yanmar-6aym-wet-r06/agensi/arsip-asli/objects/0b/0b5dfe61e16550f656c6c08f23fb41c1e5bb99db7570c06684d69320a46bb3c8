# Pump bodies use a radial cover and a neck composed around each port axis.
def pump(center,r,thick,ports,face_sign=1):
    x,y,z=center
    direction=(0,0,face_sign)
    body=[cylinder(center,Z,r,thick,cast,44,.013),
          annulus((x,y,z+face_sign*thick*.48),Z,r*.96,r*.68,.026,cast),
          cylinder((x,y,z+face_sign*(thick*.5+.018)),Z,r*.77,.024,cover,44,.004)]
    for i in range(6):
        a=i*pi/3+.27
        body.append(bolt((x+r*.87*cos(a),y+r*.87*sin(a),z+face_sign*(thick*.5+.019)),direction,.010))
    for end,pr,axis in ports:
        body += [sweep([(x,y,z),tuple((a+b)/2 for a,b in zip(center,end)),end],pr,cast),
                 *flange(end,axis,pr*1.40,pr*.76,.019,cast,4)]
    return body

