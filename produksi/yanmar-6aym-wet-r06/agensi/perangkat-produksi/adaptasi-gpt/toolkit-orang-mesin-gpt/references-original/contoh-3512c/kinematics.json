{
 "catatan": "Sudut engkol phi (derajat) = 0 saat silinder 1 di TDC pembakaran; model statis disusun pada phi=0. Putaran CCW dilihat dari flywheel (D02/D05 DOCUMENTED) = rotasi positif mengitari sumbu -X (tangan kanan). beta diukur pada bidang YZ dari +Y ke +Z; beta_crankpin(phi) = beta_crankpin_0 - phi.",
 "satuan": "m, derajat",
 "radius_engkol": 0.1075,
 "radius_engkol_status": "DOCUMENTED (stroke 215 mm / 2, D02 hlm. 1)",
 "panjang_rod": 0.381,
