# ================= RAKITAN: PENDINGIN DEPAN (tangki ekspansi + heat exchanger) =================
tk = Part("EXT-TANGKI-01", "Tangki ekspansi (expansion tank) dengan atap miring dan tutup pengisi", "PENDINGIN", YEL, "ESTIMATED",
          SRC_D01S + " (kotak X 2.107..2.386, Y s/d 1.181); " + SRC_D01F + " (Z -0.561..0.542); P22, P23 (marine: tangki atap miring selebar mesin)",
          "pembagian tinggi tangki/HE (y 0.95) ESTIMATED dari P23 (tangki kira-kira 1/3 atas)")
