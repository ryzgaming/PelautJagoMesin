:root {
  color-scheme: dark;
  --bg:#151b1e;--surface:#20282c;--surface-raised:#283337;
  --line:#414f53;--text:#f3f6f5;--soft:#b7c7c7;--accent:#79ead0;
  --gutter-left:max(16px,env(safe-area-inset-left));
  --gutter-right:max(16px,env(safe-area-inset-right));
  --bottom:max(12px,env(safe-area-inset-bottom));
  font: 100%/1.45 system-ui,sans-serif;
}
* { box-sizing:border-box }
[hidden] { display:none !important }
body { display:grid; grid-template-rows:auto minmax(0,1fr) auto; width:100%; height:100dvh; margin:0; overflow:hidden; background:var(--bg); color:var(--text) }
header { z-index:2; min-width:0; display:flex; align-items:center; justify-content:space-between; gap:.5rem; padding:max(.65rem,env(safe-area-inset-top)) var(--gutter-right) .65rem var(--gutter-left); background:var(--bg); border-bottom:1px solid var(--line) }
h1,h2,h3,p { margin:0 }
h1 { font-size:clamp(1.15rem,2.5vw,1.65rem); line-height:1.1 }
h2 { font-size:1.15rem }
h3 { font-size:1rem }
.eyebrow { margin-bottom:.3rem; color:var(--accent); font-size:.75rem; letter-spacing:.09em; font-weight:700 }
.rating { margin-top:.3rem; color:var(--soft); font-size:.875rem }
button { min-height:44px; padding:.4rem .7rem; color:var(--text); font:inherit; font-size:.875rem; background:var(--surface); border:1px solid var(--line); border-radius:.55rem; cursor:pointer }
button:hover { background:var(--surface-raised) }
button[aria-pressed=true] { color:var(--accent); border-color:var(--accent); background:#213936 }
button:disabled { opacity:.55; cursor:default }
:focus-visible { outline:2px solid var(--accent); outline-offset:2px }
a { color:var(--accent); overflow-wrap:anywhere }
#workspace { min-height:0; display:flex; min-width:0; position:relative }
#stage { flex:1 1 auto; min-width:0; min-height:0; position:relative; background:radial-gradient(ellipse at 50% 44%,#354245,#1b2226 70%,#171e21); overflow:hidden }
#canvas,#canvas canvas { display:block; width:100%; height:100%; touch-action:none }
#loading { position:absolute; inset:42% max(16px,10% ) auto; text-align:center; color:var(--soft); pointer-events:none }
.stage-tools { position:absolute; inset:.55rem var(--gutter-right) auto var(--gutter-left); display:flex; align-items:start; justify-content:flex-end; gap:.4rem; pointer-events:none }
.stage-tools button { pointer-events:auto }
.gesture { position:absolute; inset:auto var(--gutter-right) .6rem var(--gutter-left); color:var(--soft); font-size:.8rem; text-align:center; pointer-events:none }
#panel { z-index:1; width:clamp(310px,32vw,425px); flex:none; overflow:auto; background:var(--surface); border-left:1px solid var(--line); scrollbar-width:thin; overflow-wrap:anywhere; overscroll-behavior:contain }
.panel-head { position:sticky; top:0; z-index:2; display:flex; align-items:center; justify-content:space-between; gap:.5rem; padding:.45rem .9rem; border-bottom:1px solid var(--line); background:var(--surface) }
#panel-body { padding:.8rem .9rem 1rem; display:grid; gap:.75rem }
#panel-body p,li,summary { color:var(--soft) }
#panel-body small { display:block; color:var(--soft) }
.details,.system-edges li { display:grid; gap:.45rem; border:1px solid var(--line); border-radius:.65rem; padding:.65rem }
.system-edges,.registry,.parts-list { margin:0; padding:0; list-style:none; display:grid; gap:.45rem }
.parts-list button,.group-items button { width:100%; text-align:left }
.group-items { display:grid; gap:.35rem; margin-top:.35rem }
summary { cursor:pointer; min-height:44px; padding:.65rem 0 }
.actions,.tabs { display:flex; gap:.35rem; flex-wrap:wrap }
.status { color:var(--accent); font-size:.8rem; font-weight:650; letter-spacing:.03em }
#spread-box { position:absolute; z-index:2; left:50%; transform:translateX(-50%); bottom:calc(var(--bottom) + 68px); width:min(360px,calc(100% - 32px)); padding:.45rem .7rem 0; background:var(--surface); border:1px solid var(--line); border-radius:.7rem }
#spread-box label { display:flex; justify-content:space-between; font-size:.875rem }
#spread { display:block; margin:0; width:100%; min-height:44px; accent-color:var(--accent) }
body.overview-open .gesture { bottom:5.7rem }
nav { z-index:3; justify-self:center; align-self:center; width:min(100%,600px); display:grid; grid-template-columns:1.45fr 1fr 1.35fr .75fr; gap:.32rem; padding:.45rem var(--gutter-right) var(--bottom) var(--gutter-left); background:var(--bg) }
nav button { padding:.35rem .2rem; min-width:0; line-height:1.2 }
.assembly-callouts { position:absolute; inset:0; pointer-events:none }
.assembly-callouts svg { position:absolute; width:100%; height:100%; stroke:var(--accent); stroke-width:1px }
.assembly-callouts button { position:absolute; left:0; top:0; width:44px; min-height:44px; border-radius:50%; padding:0; pointer-events:auto }
.assembly-sheet { display:grid; gap:.5rem }
.assembly-sheet ol { padding-left:1.4rem }
.assembly-sheet li { margin:.3rem 0 }
@media(max-width:700px) and (orientation:portrait) {
  #workspace { flex-direction:column }
  #panel { width:100%; max-height:45%; border-left:0; border-top:1px solid var(--line) }
}
@media (max-height:520px) and (orientation:landscape) {
  header { padding-top:env(safe-area-inset-top); padding-bottom:.25rem }
  .eyebrow,.gesture { display:none }
  #panel { width:min(44vw,390px) }
}

.parts-search { display:grid; gap:.35rem }
.parts-search label { font-size:.875rem }
.parts-search input { min-width:0; min-height:44px; padding:.55rem .65rem; color:var(--text); background:var(--bg); border:1px solid var(--line); border-radius:.5rem; font:inherit; }
.parts-results { display:grid; gap:.35rem }
.group-items button small { margin-top:.12rem; font-size:.75rem }

.stage-tools { flex-wrap:wrap }
#inspect-contents { color:var(--accent); border-color:var(--accent) }
.assembly-toolbar { display:grid; gap:.45rem }
.assembly-toolbar > button { justify-self:start }
.coverage-note { border-left:2px solid var(--line); padding-left:.6rem }
.evidence summary { min-height:44px; padding:.45rem 0 }
