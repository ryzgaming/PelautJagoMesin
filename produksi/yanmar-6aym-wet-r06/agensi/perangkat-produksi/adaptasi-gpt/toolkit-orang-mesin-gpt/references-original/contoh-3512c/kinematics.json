 "firing_order_status": "INFERRED (D06, 3512 awal, CCW)",
 "interval_pembakaran_deg": 60,
 "rumus": {
  "crank": "objek INT-CRANK-01, INT-GEAR-R-CRANK, INT-GEAR-F-CRANK serta node EXTERIOR EXT-FLYWHEEL-01 (termasuk ring gear 183 gigi) dan EXT-DAMPER-01 (flywheel dan damper tidak dimodelkan di internal): rotation_x = -phi (rad), pusat sumbu X",
  "crankpin": "P = (crankpin_x, r*cos(beta), r*sin(beta)), beta = beta_crankpin_0 - phi",
  "alpha": "alpha = beta - beta_bank (beta_bank = +30 kanan, -30 kiri)",
  "piston": "s = r*cos(alpha) + sqrt(L^2 - (r*sin(alpha))^2); pin = (x_silinder,0,0) + s*sumbu; objek piston/pin/ring hanya bertranslasi sepanjang sumbu: posisi = posisi_awal + (s - s0)*sumbu. Pada phi=0 model statis = posisi ini.",
  "rod": "INT-ROD-NN: origin di P (pada rod_x), hanya rotasi X: rotation_x = atan2(Qz-Pz, Qy-Py), Q = pin piston. INT-ROD-NN-CAP/BOLT1/BOLT2: transformasi relatif tetap terhadap rod, M(phi) = M_rod(phi) @ inverse(M_rod(0)) @ M_awal (atau jadikan child rod)",
  "cam": "INT-CAM-R/L dan INT-GEAR-R-CAM-R/L: rotation_x = -phi/2 relatif ke posisi awal (rasio 1:2, arah searah crank ILLUSTRATIVE)",
  "idler": "INT-GEAR-R-IDLER-R/L: rotation_x = +phi*36/44 (berlawanan arah crank)",
  "pompa_oli": "INT-GEAR-F-OILPUMP dan INT-OILPUMP-GEAR1: rotation_x = +phi*36/26; INT-OILPUMP-GEAR2: rotation_x = -phi*36/26",
  "lift_lobe": "lift = h*cos^2(90*d/hd) bila |d|<hd, d = phi - puncak (dibungkus ke -360..360); h IN/EX 0.010, INJ 0.008; hd IN/EX 120, INJ 60 (semua ILLUSTRATIVE)",
  "valve_train": "tappet dan ujung bawah push rod naik sepanjang sumbu bank sebesar lift; rocker berputar mengitari X lokal delta = -s*lift/0.055 rad (s=+1 kanan, -1 kiri); bridge, katup, retainer turun sepanjang -sumbu sebesar lift*1.200 (rasio rocker 0.066/0.055); pegas memendek sama; plunger injector turun lift*1.200. Nilai lift dan delta pada phi=0 ada di valve_train_awal."
 },
