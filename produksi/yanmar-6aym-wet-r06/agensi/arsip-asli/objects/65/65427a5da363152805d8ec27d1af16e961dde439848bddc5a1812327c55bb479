def gear(part,label,group,pivot,pr,width,teeth,inner,hand,parent=None,phase=0,**meta):
    center=(0,0,0) if parent else pivot
    x,y,z=center
    count=teeth*6
    vertices=[]
    for axial,radial,twist in [(-width/2,0,0),(-width/2,1,-.18*hand),(0,1,0),(width/2,1,.18*hand),(width/2,0,0)]:
        for q in range(count):
            s=q%6
            r=inner if radial==0 else pr + [-.0029,-.0029,.0024,.0024,.0024,-.0029][s]
            a=phase+TAU*(q+twist)/count
            vertices.append((x+axial,y+r*math.cos(a),z+r*math.sin(a)))
    faces=[]
    for row in range(5):
        for q in range(count):
            s=(q+1)%count
            a,b=row*count,((row+1)%5)*count
            faces.append((a+q,a+s,b+s,b+q))
    return make(part,label,group,vertices,faces,turned,parent,center,False,**meta)

