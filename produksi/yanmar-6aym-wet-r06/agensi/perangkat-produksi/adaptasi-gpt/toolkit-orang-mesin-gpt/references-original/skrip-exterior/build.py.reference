# Exterior 3512C HD marine - Blender 5.3 bpy. Semua koordinat ditulis dalam sistem datum
# (Y atas, +X depan, +Z kanan) lalu dikonversi ke Blender Z-up: B = (x, -z, y).
import bpy, bmesh, json, math, os, sys
from mathutils import Vector, Matrix

OUT = "/tmp/claude-0/c3512/model/exterior"
FIX = int(os.environ.get("FIX", "1"))   # 0 = versi awal, 1 = setelah putaran perbaikan
V = Vector
C3 = Matrix(((1, 0, 0), (0, 0, -1), (0, 1, 0)))
C4 = C3.to_4x4()

bpy.ops.wm.read_factory_settings(use_empty=True)
scene = bpy.context.scene

# ---------------- material ----------------
def mat(name, rgb, metal=0.0, rough=0.5):
    m = bpy.data.materials.new(name)
    m.use_nodes = True
    b = m.node_tree.nodes.get("Principled BSDF")
    b.inputs["Base Color"].default_value = (*rgb, 1)
    b.inputs["Metallic"].default_value = metal
    b.inputs["Roughness"].default_value = rough
    m.diffuse_color = (*rgb, 1); m.metallic = metal; m.roughness = rough
    return m

def s2l(c):
    c = c / 255.0
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4

YEL = mat("CAT_Yellow_EST", tuple(s2l(v) for v in (232, 178, 82)), 0.0, 0.45)   # median piksel P22/P23
BLK = mat("Black_Rail", (0.018, 0.018, 0.018), 0.0, 0.55)
TRB = mat("Turbo_Metal_DarkGray", (0.10, 0.10, 0.11), 0.85, 0.45)
SHD = mat("HeatShield_Gray", (0.52, 0.53, 0.55), 0.7, 0.35)
STL = mat("Steel_Bolt", (0.62, 0.62, 0.64), 1.0, 0.35)
RUB = mat("Rubber_Black", (0.012, 0.012, 0.012), 0.0, 0.85)
MED = mat("AirFilter_Media_Blue", (0.03, 0.07, 0.25), 0.0, 0.9)
FLY = mat("Flywheel_Steel", (0.20, 0.20, 0.21), 0.9, 0.5)
PNL = mat("Panel_Black", (0.025, 0.025, 0.03), 0.1, 0.4)
GRY = mat("Starter_Gray", (0.35, 0.36, 0.37), 0.5, 0.5)
FWH = mat("Filter_White", (0.80, 0.80, 0.78), 0.0, 0.5)

# ---------------- geometri dasar (datum) ----------------
def frame(axis, up=(0, 1, 0)):
    z = V(axis).normalized()
    u = V(up)
    if abs(z.dot(u)) > 0.95:
        u = V((1, 0, 0)) if abs(z.x) < 0.9 else V((0, 0, 1))
    x = u.cross(z).normalized()
    y = z.cross(x)
    return Matrix((x, y, z)).transposed()

def M4(c, R=None, s=(1, 1, 1)):
    R = R if R is not None else Matrix.Identity(3)
    return Matrix.Translation(V(c)) @ R.to_4x4() @ Matrix.Diagonal((*s, 1))

INV = []
COLL = {}
EMP = {}

class Part:
    def __init__(self, pid, nama, rak, mat_, status, sumber, catatan="", jumlah=1):
        self.pid, self.nama, self.rak, self.status, self.sumber, self.catatan, self.jumlah = pid, nama, rak, status, sumber, catatan, jumlah
        self.bm = bmesh.new(); self.mats = [mat_]
    def mi(self, m):
        if m is None: return 0
        if m not in self.mats: self.mats.append(m)
        return self.mats.index(m)
    def _setmat(self, faces, m):
        i = self.mi(m)
        for f in faces: f.material_index = i
    def _new_faces(self, before):
        return [f for f in self.bm.faces if f.index == -1 or f not in before]

    def box(self, c, s, R=None, bev=0.0, seg=2, m=None):
        before = set(self.bm.faces)
        r = bmesh.ops.create_cube(self.bm, size=1.0, matrix=M4(c, R, s))
        if bev > 0:
            edges = list({e for v in r["verts"] for e in v.link_edges})
            bmesh.ops.bevel(self.bm, geom=edges, offset=bev, segments=seg, affect="EDGES", profile=0.5, clamp_overlap=True)
        self._setmat([f for f in self.bm.faces if f not in before], m)

    def cyl(self, c, axis, r, h, n=24, r2=None, bev=0.0, m=None, up=(0, 1, 0)):
        before = set(self.bm.faces)
        R = frame(axis, up)
        res = bmesh.ops.create_cone(self.bm, cap_ends=True, cap_tris=False, segments=n, radius1=r,
                                    radius2=(r if r2 is None else r2), depth=h, matrix=M4(c, R))
        if bev > 0:
            edges = [e for e in {e for v in res["verts"] for e in v.link_edges}
                     if any(len(f.verts) > 4 for f in e.link_faces)]
            bmesh.ops.bevel(self.bm, geom=edges, offset=bev, segments=2, affect="EDGES", clamp_overlap=True)
        self._setmat([f for f in self.bm.faces if f not in before], m)

    def bolt(self, c, axis, r=0.012, h=0.014, m=STL):
        self.cyl(V(c) + V(axis).normalized() * h / 2, axis, r, h, n=6, m=m)

    def bolt_circle(self, c, axis, rc, nb, r=0.011, h=0.012, ang0=0.0, m=STL):
        R = frame(axis)
        for i in range(nb):
            a = ang0 + 2 * math.pi * i / nb
            p = V(c) + R @ V((rc * math.cos(a), rc * math.sin(a), 0))
            self.bolt(p, axis, r, h, m)

    def lathe(self, prof, c, axis, n=32, caps=(True, True), m=None, up=(0, 1, 0), a0=0.0, a1=2 * math.pi, closed=True):
        bm = self.bm; R = frame(axis, up); rings = []
        nn = n if closed else n + 1
        for (r, h) in prof:
            ring = []
            for i in range(nn):
                a = a0 + (a1 - a0) * i / n
                ring.append(bm.verts.new(V(c) + R @ V((r * math.cos(a), r * math.sin(a), h))))
            rings.append(ring)
        fs = []
        for k in range(len(rings) - 1):
            A, B = rings[k], rings[k + 1]
            for i in range(n):
                j = (i + 1) % nn
                fs.append(bm.faces.new((A[i], A[j], B[j], B[i])))
        if closed:
            if caps[0] and prof[0][0] > 1e-5: fs.append(bm.faces.new(list(reversed(rings[0]))))
            if caps[1] and prof[-1][0] > 1e-5: fs.append(bm.faces.new(rings[-1]))
        self._setmat(fs, m)
        return rings

    def sweep(self, path, radius, n=16, caps=True, closed=False, m=None):
        bm = self.bm
        pts = [V(p) for p in path]
        rad = radius if isinstance(radius, (list, tuple)) else [radius] * len(pts)
        P, Rr = [pts[0]], [rad[0]]
        for p, r in zip(pts[1:], rad[1:]):
            if (p - P[-1]).length > 1e-5: P.append(p); Rr.append(r)
        N = len(P)
        T = []
        for i in range(N):
            if closed: t = P[(i + 1) % N] - P[i - 1]
            elif i == 0: t = P[1] - P[0]
            elif i == N - 1: t = P[-1] - P[-2]
            else: t = (P[i + 1] - P[i]).normalized() + (P[i] - P[i - 1]).normalized()
            T.append(t.normalized())
        nrm = frame(T[0]).col[0]
        rings = []
        for i in range(N):
            if i > 0:
                q = T[i - 1].rotation_difference(T[i]); nrm = q @ nrm
                nrm = (nrm - T[i] * nrm.dot(T[i])).normalized()
            b = T[i].cross(nrm)
            rings.append([bm.verts.new(P[i] + Rr[i] * (math.cos(2 * math.pi * k / n) * nrm + math.sin(2 * math.pi * k / n) * b)) for k in range(n)])
        fs = []
        segs = range(N) if closed else range(N - 1)
        for i in segs:
            A, B = rings[i], rings[(i + 1) % N]
            for k in range(n):
                fs.append(bm.faces.new((A[k], A[(k + 1) % n], B[(k + 1) % n], B[k])))
        if caps and not closed:
            fs.append(bm.faces.new(list(reversed(rings[0])))); fs.append(bm.faces.new(rings[-1]))
        self._setmat(fs, m)
        return P, T

    def loft(self, sections, caps=True, m=None):
        bm = self.bm
        rings = [[bm.verts.new(V(p)) for p in s] for s in sections]
        n = len(sections[0]); fs = []
        for a, b in zip(rings[:-1], rings[1:]):
            for k in range(n):
                fs.append(bm.faces.new((a[k], a[(k + 1) % n], b[(k + 1) % n], b[k])))
        if caps:
            fs.append(bm.faces.new(list(reversed(rings[0])))); fs.append(bm.faces.new(rings[-1]))
        self._setmat(fs, m)

    def prism(self, poly, axis_pts, plane="zy", bev=0.0, m=None):
        """poly: titik 2D; plane 'zy' diekstrusi sepanjang X (axis_pts=(x0,x1)); 'xy' sepanjang Z."""
        bm = self.bm; a0, a1 = axis_pts
        def P3(q, t):
            return V((t, q[1], q[0])) if plane == "zy" else V((q[0], q[1], t))
        A = [bm.verts.new(P3(q, a0)) for q in poly]
        B = [bm.verts.new(P3(q, a1)) for q in poly]
        n = len(poly); fs = [bm.faces.new(A), bm.faces.new(list(reversed(B)))]
        for k in range(n):
            fs.append(bm.faces.new((A[(k + 1) % n], A[k], B[k], B[(k + 1) % n])))
        bmesh.ops.recalc_face_normals(bm, faces=fs)
        if bev > 0:
            edges = list({e for f in fs for e in f.edges})
            r = bmesh.ops.bevel(bm, geom=edges, offset=bev, segments=2, affect="EDGES", clamp_overlap=True)
            fs = fs + list(r["faces"])
        self._setmat([f for f in fs if f.is_valid], m)

    def finish(self):
        bm = self.bm
        bmesh.ops.transform(bm, matrix=C4, verts=bm.verts)
        bmesh.ops.recalc_face_normals(bm, faces=bm.faces)
        me = bpy.data.meshes.new(self.pid)
        bm.to_mesh(me); bm.free()
        for mm in self.mats: me.materials.append(mm)
        cen = sum((v.co for v in me.vertices), V()) / max(1, len(me.vertices))
        me.transform(Matrix.Translation(-cen))
        ob = bpy.data.objects.new(self.pid, me)
        ob.location = cen
        for p in me.polygons: p.use_smooth = False
        if self.rak not in COLL:
            c = bpy.data.collections.new("RAK-" + self.rak); scene.collection.children.link(c); COLL[self.rak] = c
            e = bpy.data.objects.new("RAK-" + self.rak, None); c.objects.link(e); EMP[self.rak] = e
        COLL[self.rak].objects.link(ob); ob.parent = EMP[self.rak]
        # ukuran bbox dalam datum
        ws = [C3.inverted() @ (v.co + cen) for v in me.vertices]
        lo = V((min(w.x for w in ws), min(w.y for w in ws), min(w.z for w in ws)))
        hi = V((max(w.x for w in ws), max(w.y for w in ws), max(w.z for w in ws)))
        INV.append(dict(id=self.pid, nama=self.nama, rakitan=self.rak, jumlah=self.jumlah, status=self.status,
                        sumber=self.sumber, ukuran_utama_m=dict(dx=round(hi.x - lo.x, 3), dy=round(hi.y - lo.y, 3), dz=round(hi.z - lo.z, 3)),
                        bbox_datum_m=dict(min=[round(t, 3) for t in lo], max=[round(t, 3) for t in hi]), catatan=self.catatan))
        return ob

def fillet(pts, r, n=8):
    pts = [V(p) for p in pts]; out = [pts[0]]
    for i in range(1, len(pts) - 1):
        a, b, c = pts[i - 1], pts[i], pts[i + 1]
        d1, d2 = b - a, c - b
        rr = min(r, d1.length * 0.45, d2.length * 0.45)
        p0 = b - d1.normalized() * rr; p2 = b + d2.normalized() * rr
        for k in range(n + 1):
            t = k / n
            out.append((1 - t) ** 2 * p0 + 2 * (1 - t) * t * b + t * t * p2)
    out.append(pts[-1]); return out

def pipe(p, pts, r, bend=0.12, flanges=(True, True), fr=None, nb=6, n=20, m=None, fm=None):
    path = fillet(pts, bend)
    P, T = p.sweep(path, r, n=n, m=m)
    fr = fr or r * 1.55
    for k, use in ((0, flanges[0]), (-1, flanges[1])):
        if not use: continue
        t = T[k] if k == -1 else -T[0]
        c = P[k] - t * 0.012
        p.cyl(c, t, fr, 0.024, n=n, m=fm if fm else m, bev=0.004)
        p.bolt_circle(c + t * 0.012, t, (fr + r) / 2, nb, r=min(0.011, (fr - r) / 2.6), h=0.01)
    return P, T

def rrect(cx, zc, yc, w, h, r, n=64):
    """bagian persegi bulat di bidang Z-Y pada x=cx; titik berjumlah tetap n (untuk loft)."""
    r = min(r, w / 2, h / 2)
    hw, hh = w / 2 - r, h / 2 - r
    pts = []
    for i in range(n):
        a = 2 * math.pi * i / n
        dz, dy = math.cos(a), math.sin(a)
        # proyeksi superelips sederhana: pusat sudut + r*arah
        sz = hw * (1 if dz > 0 else -1) if abs(dz) > 1e-9 else 0
        sy = hh * (1 if dy > 0 else -1) if abs(dy) > 1e-9 else 0
        pts.append(V((cx, yc + sy + r * dy, zc + sz + r * dz)))
    return pts

ASM = {}
def asm_part(aid, no, nama, status, sumber, fungsi):
    A = ASM[aid]
    A["bagian"].setdefault(no, dict(no=no, nama=nama, object_ids=[], posisi=[], status=status, sumber=sumber, fungsi=fungsi, nomor_oem=None, ukuran=None))
def asm_pos(aid, no, oid, arah, jarak, urutan):
    b = ASM[aid]["bagian"][no]
    b["object_ids"].append(oid)
    b["posisi"].append(dict(object_id=oid, arah=[round(v, 4) for v in V(arah).normalized()], jarak_m=jarak, urutan=urutan))

# ---------------- data datum ----------------
CYLX = [1.563, 1.293, 1.023, 0.753, 0.483, 0.213]   # silinder 1,3,5,7,9,11 (bank kanan), datum.json
BANK_OFF = 0.065   # offset bank kiri: UNKNOWN di datum; 0.065 m ILLUSTRATIVE, disamakan dengan Internal Modeler (silinder 2 di X 1.498, 12 di X 0.148)
LNOTE = "bank kiri digeser -0.065 m di X (offset bank kiri ILLUSTRATIVE, disamakan dengan Internal Modeler: dua connecting rod berdampingan per crankpin pada V12; nilai tidak tertulis di dokumen)"
S30, C30 = 0.5, math.sqrt(3) / 2
def bank(s):
    u = V((0, C30, s * S30)); n = V((0, -S30, s * C30)); return u, n
def BP(s, x, d, a):
    u, n = bank(s); return V((x, 0, 0)) + u * d + n * a
def bankR(s):
    u, n = bank(s); X = V((1, 0, 0)); return Matrix((X, u, X.cross(u))).transposed()

SRC_D01S = "D01 hlm. 1 gambar Dimensions tampak Right Side (skala 3.107 mm/px, datum.json)"
SRC_D01F = "D01 hlm. 1 gambar Dimensions tampak Front (datum.json)"
SRC_D02R = "D02 hlm. 1 render 3D samping kanan dan depan (img/side-1.png, img/front-1.png)"

# ================= RAKITAN: REL DUDUKAN =================
for s, tag in ((1, "R"), (-1, "L")):
    p = Part(f"EXT-REL-{tag}", f"Rel dudukan (mounting rail) {'kanan' if s>0 else 'kiri'}", "REL", BLK, "ESTIMATED",
             SRC_D01S + "; " + SRC_D01F + "; " + SRC_D02R,
             "x -0.295..1.905, y -0.528..-0.32, z luar 0.589 (datum.mounting_feet); penampang kanal C dan tebal pelat ILLUSTRATIVE")
    zo = 0.589 * s
    # web tegak + flens atas/bawah (kanal C menghadap ke dalam)
    p.box((0.805, -0.424, zo - s * 0.012), (2.20, 0.208, 0.024), bev=0.004)
    p.box((0.805, -0.332, zo - s * 0.10), (2.20, 0.024, 0.20), bev=0.004)
    p.box((0.805, -0.516, zo - s * 0.10), (2.20, 0.024, 0.20), bev=0.004)
    # kelompok lubang/baut (D02 render: 2x2, 1x2, 1x2, 2x3)
    for gx, cols, rows in ((-0.013, 2, 2), (0.58, 1, 2), (1.20, 1, 2), (1.73, 2, 3)):
        for ci in range(cols):
            for ri in range(rows):
                p.bolt((gx + ci * 0.06 - (cols - 1) * 0.03, -0.39 - ri * 0.05 + (rows - 2) * 0.0, zo), (0, 0, s), r=0.014, h=0.012)
    p.finish()
    q = Part(f"EXT-BRAKET-{tag}", f"Braket dudukan blok ke rel {'kanan' if s>0 else 'kiri'} (4 buah)", "REL", YEL, "ILLUSTRATIVE",
             SRC_D02R + " (tiang penghubung terlihat di atas rel)", "posisi x mengikuti kelompok baut rel; bentuk ILLUSTRATIVE", jumlah=4)
    for gx in (-0.013, 0.58, 1.20, 1.73):
        q.box((max(gx, 0.06), -0.29, s * 0.50), (0.14, 0.07, 0.20), bev=0.01)
        q.box((max(gx, 0.06), -0.29, s * 0.50), (0.02, 0.07, 0.20), R=None, bev=0.0)
    q.finish()

# ================= RAKITAN: OIL PAN =================
p = Part("EXT-OILPAN-01", "Oil pan (sump) dengan flens", "OILPAN", YEL, "ESTIMATED", SRC_D01S + "; " + SRC_D01F,
         "dasar y -0.805, flens -0.264, sump bawah x -0.028..1.771, lebar +-0.39 (datum.oil_pan); tebal flens dan jarak baut ILLUSTRATIVE")
