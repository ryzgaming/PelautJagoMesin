        b.box((-0.28, 0.45, s * 0.60), (0.02, 0.16, 0.36), bev=0.003)
    b.finish()

# ================= RAKITAN: AFTERCOOLER =================
ac = Part("EXT-AFTERCOOLER-01", "Rumah aftercooler (separate circuit aftercooler) bersirip di atas lembah V", "AFTERCOOLER", YEL, "ESTIMATED",
          SRC_D01S + " (kotak berbaut X 0.336..1.398, Y 0.91..1.227; datum.aftercooler); P12, P15, P17 (rumah bersirip-rusuk); D03 hlm. 1",
          "lebar Z +-0.30 ESTIMATED dari P12 (kira-kira 0.35x lebar mesin); identitas sebagai aftercooler INFERRED di datum")
ac.box((0.867, 1.09, 0), (1.062, 0.27, 0.60), bev=0.025, seg=2)
