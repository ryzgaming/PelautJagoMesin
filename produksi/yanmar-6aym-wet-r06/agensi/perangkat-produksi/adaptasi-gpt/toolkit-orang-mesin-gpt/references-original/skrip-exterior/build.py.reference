pl = Part("EXT-HEXPLATE-01", "Pelat depan berbentuk X pada heat exchanger (tanpa logo)", "HX", PNL, "OBSERVED",
          "P23 (pelat X di depan heat exchanger)", "tulisan merek tidak dibuat (aturan tanpa logo); ukuran ESTIMATED")
