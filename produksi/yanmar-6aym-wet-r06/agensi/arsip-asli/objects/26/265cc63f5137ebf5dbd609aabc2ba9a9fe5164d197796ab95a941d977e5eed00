"""Compare the baseline and revised fuel side from the same fixed cameras."""
import argparse
from pathlib import Path
import sys

import bpy
from mathutils import Vector

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--output', type=Path, required=True)
parser.add_argument('--baseline', type=Path)
parser.add_argument('--before', default='r01')
parser.add_argument('--after', default='r02')
args = parser.parse_args(sys.argv[sys.argv.index('--')+1:])
folder = Path(__file__).resolve().parent
output = args.output.resolve()
output.mkdir(exist_ok=True, parents=True)

for name, glb in ((args.before, args.baseline or folder/'r01-baseline/exterior.glb'),
                  (args.after, folder/'exterior.glb')):
    bpy.ops.wm.read_factory_settings(use_empty=True)
    bpy.ops.import_scene.gltf(filepath=str(glb))
    scene = bpy.context.scene
    scene.render.engine = 'CYCLES'
    scene.cycles.device = 'CPU'
    scene.cycles.samples = 4
    scene.cycles.use_denoising = False
    scene.render.resolution_x = 780
    scene.render.resolution_y = 440
    scene.render.resolution_percentage = 100
    scene.render.image_settings.file_format = 'PNG'
    scene.world = bpy.data.worlds.new('Photo Detail')
    scene.world.use_nodes = True
    scene.world.node_tree.nodes['Background'].inputs[0].default_value = (.3,.3,.3,1)
    scene.world.node_tree.nodes['Background'].inputs[1].default_value = .55
    scene.view_settings.view_transform = 'AgX'

    center = Vector((.68,.406,.422))
    for label,p,power,size in [
            ('Key',(2.,3.,2.5),320,2.5),
            ('Fill',(-1.,1.95,1.3),140,2.2),
            ('Rim',(.7,-1.6,2.6),145,2.4)]:
        light = bpy.data.lights.new(label,'AREA')
        light.energy,light.size = power,size
        lamp = bpy.data.objects.new(label,light)
        scene.collection.objects.link(lamp)
        lamp.location = p
        lamp.rotation_euler = (center-lamp.location).to_track_quat('-Z','Y').to_euler()

    neutral = bpy.data.materials.new('Neutral')
    neutral.diffuse_color = (.46,.46,.46,1)
    camera = bpy.data.cameras.new('Fuel Detail')
    camera.type = 'ORTHO'
    camera.ortho_scale = 1.43
    obj = bpy.data.objects.new('Fuel Detail', camera)
    scene.collection.objects.link(obj)
    scene.camera = obj
    for label,view in [('p07',(0,1,.045)),('p08',(.42,1,.15))]:
        obj.location = center+Vector(view).normalized()*5
        obj.rotation_euler = (center-obj.location).to_track_quat('-Z','Y').to_euler()
        for mode in ('color','neutral'):
            scene.view_layers[0].material_override = neutral if mode=='neutral' else None
            scene.render.filepath = str(output/f'{name}_{label}_{mode}.png')
            bpy.ops.render.render(write_still=True)
