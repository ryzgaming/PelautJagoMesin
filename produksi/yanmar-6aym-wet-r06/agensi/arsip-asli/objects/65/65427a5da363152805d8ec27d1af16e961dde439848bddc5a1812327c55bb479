def empty(name, p=(0,0,0), parent=None, axis=None):
    ob = bpy.data.objects.new(name,None)
    scene.collection.objects.link(ob)
    ob.location = v(p)
    ob.empty_display_size = .025
    ob.parent = parent
    if axis:
        MOTION[name] = dict(parent=parent.name, rest_translation_m=list(p),axis=list(axis))
    return ob

