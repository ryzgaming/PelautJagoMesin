run("openDiagram(entries.get('EXT-FLYWHEEL-02'))");
drawFrames();
assert.equal(run('state.mode'),'assembly');
assert.equal(run('state.assemblyParts.size'),2);
assert.equal(run("groups.get('RAK-FRONT').object.visible"),false);
const sheet = entries.get('panel-body').children[0];
const toggle = sheet.children[2];
assert.equal(toggle.textContent,'Rapatkan rakitan');
toggle.click();
assert.equal(toggle.textContent,'Uraikan rakitan');
entries.get('close').click();
assert.equal(run('state.mode'),'component');
assert.equal(run('state.selected'),'EXT-FLYWHEEL-02');
assert.equal(run("groups.get('RAK-FRONT').object.visible"),true);
entries.get('reset').click();
assert.equal(run('state.mode'),'home');
assert.equal(run('state.selected'),null);
assert.equal(entries.get('panel').hidden,true);
assert.equal(entries.get('spread').value,50);
console.log('PASS: '+(offline?'Offline embedded':'Separate-file')+' GLTFs and mock DOM. State, animation, diagram and camera aspect exercised. Browser layout, gestures and WebGL rendering not tested.');
