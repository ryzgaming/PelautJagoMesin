# Preserve the clamp positions and boundary, changing only the triangulation
# of the one planar n-gon with a collinear boundary point.
clamp=bpy.data.objects.get('EXT-EXHAUST-56')
if clamp:
    import bmesh
    clamp.data.calc_loop_triangles()
    sliver_faces={t.polygon_index for t in clamp.data.loop_triangles if t.area<1e-12}
    if sliver_faces:
        bm=bmesh.new()
        bm.from_mesh(clamp.data)
        bm.faces.ensure_lookup_table()
        bmesh.ops.triangulate(bm,faces=[bm.faces[i] for i in sorted(sliver_faces)],
                              ngon_method='BEAUTY',quad_method='BEAUTY')
        bm.to_mesh(clamp.data)
        bm.free()
        clamp.data.update()

# Save editable source model, selected parts list and diagram motion metadata.
def write_json(path,data):
    path.write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\n')

