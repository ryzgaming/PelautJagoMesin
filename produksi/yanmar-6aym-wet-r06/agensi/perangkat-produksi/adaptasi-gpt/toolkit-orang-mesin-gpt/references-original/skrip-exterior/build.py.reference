    gd.sweep([V((2.085, 0.05 * math.sin(a), 0.05 * math.cos(a))), V((2.085, 0.326 * math.sin(a), 0.326 * math.cos(a))), V((1.95, 0.33 * math.sin(a), 0.33 * math.cos(a)))], 0.005, n=6)
