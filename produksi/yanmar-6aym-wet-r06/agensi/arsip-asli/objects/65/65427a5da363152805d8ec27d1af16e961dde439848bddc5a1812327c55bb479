def catalog_reference(row):
    part, label = row["id"],row["name"]
    if part.startswith("INT-CRANK-"):
        return "D05 Fig. 38 ref 1/1B–1G", None, "Main crankshaft assembly; serial/weight option unresolved."
    if part == "INT-TIMING-01":
        return "D05 Fig. 38 ref 3","148620-21201",None
    if label.startswith("Piston dengan"):
        return "D05 Fig. 39 ref 1",None,"748699-22800 is the complete piston assembly number."
    if label == "Hollow piston pin":
        return "D05 Fig. 39 ref 9","148620-22310",None
    if label == "Piston pin retaining circlip":
        return "D05 Fig. 39 ref 10","22252-000620",None
    if part.startswith("INT-PISTON-") and "ring" in label.lower():
        return "D05 Fig. 39 ref 3",None,"748660-22500 denotes the ring set."
    if label in {"Rod cap bolt","Rod bolt head"}:
        return "D05 Fig. 39 ref 15","148620-23202",None
    if label == "Rod cap nut":
        return "D05 Fig. 39 ref 16","148620-23220",None
    if label == "Piston pin bushing":
        return "D05 Fig. 39 ref 19","148620-23820",None
    if part.startswith("INT-ROD-") and "shell" in label:
        return "D05 Fig. 39 ref 17",None,"748620-23600 denotes the standard bearing shell set; service undersizes also listed."
    if part.startswith("INT-ROD-"):
        return "D05 Fig. 39 ref 11",None,"Rod and cap assigned to observed assembly; exact catalog option unverified."
    return None,None,None

