def wrap(draw, message, typeface, width):
    lines=[]
    for word in message.split():
        if not lines or draw.textlength(lines[-1]+" "+word,font=typeface)>width:
            lines.append(word)
        else:
            lines[-1]+=" "+word
    return lines

