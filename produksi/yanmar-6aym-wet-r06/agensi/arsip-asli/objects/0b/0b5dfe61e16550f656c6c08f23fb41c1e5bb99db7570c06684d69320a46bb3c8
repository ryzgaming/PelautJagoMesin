def select(obj):
    bpy.ops.object.select_all(action='DESELECT')
    obj.select_set(True)
    bpy.context.view_layer.objects.active = obj

def shade(obj, mat, bevel=0, smooth=False):
    obj.data.materials.append(mat)
    if smooth:
        for face in obj.data.polygons:
            face.use_smooth = True
    if bevel:
        mod = obj.modifiers.new('Edge radius · visual', 'BEVEL')
        mod.width = bevel
        mod.segments = 2
        mod.limit_method = 'ANGLE'
        select(obj)
        bpy.ops.object.modifier_apply(modifier=mod.name)
        mod = obj.modifiers.new('Weighted face normals', 'WEIGHTED_NORMAL')
        mod.keep_sharp = True
        bpy.ops.object.modifier_apply(modifier=mod.name)
    return obj

def mesh(verts, faces, mat, bevel=0, smooth=False):
    data = bpy.data.meshes.new('mesh')
    data.from_pydata([world(v) for v in verts], [], faces)
    data.update()
    import bmesh
    b = bmesh.new()
    b.from_mesh(data)
    bmesh.ops.recalc_face_normals(b, faces=b.faces)
    b.to_mesh(data)
    b.free()
    obj = bpy.data.objects.new('part', data)
    bpy.context.collection.objects.link(obj)
    return shade(obj, mat, bevel, smooth)

def box(p, size, mat=cast, bevel=.008, tilt=0):
    bpy.ops.mesh.primitive_cube_add(size=1, location=world(p))
    obj = bpy.context.object
    x,y,z = size
    obj.scale = (x,z,y)
    bpy.ops.object.transform_apply(location=False, rotation=False, scale=True)
    obj.rotation_euler.y = tilt
    return shade(obj, mat, bevel, True)

def cylinder(p, axis, r, length, mat=cast, sides=32, bevel=.003):
    bpy.ops.mesh.primitive_cylinder_add(vertices=sides, radius=r, depth=length, location=world(p))
    obj = bpy.context.object
    obj.rotation_euler = world(axis).to_track_quat('Z','Y').to_euler()
    return shade(obj, mat, bevel, True)

def bolt(p, axis, r=.012, mat=boltmat):
    return cylinder(p,axis,r,.012,mat,6,.0012)

def vec_basis(axis):
    a = Vector(axis).normalized()
    b = Vector((1,0,0)) if abs(a.x)<.8 else Vector((0,1,0))
    b = (b - b.dot(a)*a).normalized()
    return a,b,a.cross(b)

def ring(p,axis,profile,mat,segments=48):
    """Revolve a closed section of (axial offset, radius) pairs."""
    a,b,c = vec_basis(axis)
    verts = [Vector(p)+offset*a+r*(b*cos(i*2*pi/segments)+c*sin(i*2*pi/segments))
             for offset,r in profile for i in range(segments)]
    faces = []
    for j in range(len(profile)):
        k = (j+1)%len(profile)
        for i in range(segments):
            n = (i+1)%segments
            faces.append((j*segments+i,j*segments+n,k*segments+n,k*segments+i))
    return mesh(verts,faces,mat,smooth=True)

def annulus(p,axis,ro,ri,length,mat=steel):
    d = length*.5
    bevel = min(length*.2,(ro-ri)*.25,.003)
    return ring(p,axis,[(-d,ri+bevel),(-d,ro-bevel),(-d+bevel,ro),(d-bevel,ro),
                       (d,ro-bevel),(d,ri+bevel),(d-bevel,ri),(-d+bevel,ri)],mat)

def flange(p,axis,ro,ri,depth,mat=cast,n=8):
    objs = [annulus(p,axis,ro,ri,depth,mat)]
    a,b,c=vec_basis(axis)
    for i in range(n):
        angle = 2*pi*(i+.5)/n
        q=Vector(p)+a*(depth/2+.003)+(ro-.014)*(b*cos(angle)+c*sin(angle))
        objs.append(bolt(q,axis,min(.013,(ro-ri)*.24)))
    return objs

def polygon_loft(rings,mat=cast,bevel=.006,closed=False):
    count=len(rings[0])
    faces = [] if closed else [tuple(reversed(range(count)))]
    for row in range(len(rings) if closed else len(rings)-1):
        nxt=(row+1)%len(rings)
        for i in range(count):
            j=(i+1)%count
            faces.append((row*count+i,row*count+j,nxt*count+j,nxt*count+i))
    if not closed:
        faces.append(tuple(range((len(rings)-1)*count,len(rings)*count)))
    return mesh([v for row in rings for v in row],faces,mat,bevel,True)

def rect(x0,x1,z0,z1,y,c):
    return [(x,y,z) for x,z in [(x0+c,z0),(x1-c,z0),(x1,z0+c),(x1,z1-c),
            (x1-c,z1),(x0+c,z1),(x0,z1-c),(x0,z0+c)]]

def shell(layers, mat=cast):
    return polygon_loft([rect(*layer) for layer in layers],mat,.003,True)

def prism(poly, axis, lo, hi, mat=cast, bevel=.006):
    if axis=='x':
        rings=[[(s,u,v) for u,v in poly] for s in (lo,hi)]
    elif axis=='y':
        rings=[[(u,s,v) for u,v in poly] for s in (lo,hi)]
    else:
        rings=[[(u,v,s) for u,v in poly] for s in (lo,hi)]
    return polygon_loft(rings,mat,bevel)

def sweep(points, radius, mat=cast, sides=16, hollow=False):
    vectors = list(map(Vector,points))
    smooth = []
    for i in range(len(vectors)-1):
        prev, p = vectors[max(0,i-1)], vectors[i]
        q, after = vectors[i+1], vectors[min(len(vectors)-1,i+2)]
        section = interpolate_bezier(p,p+(q-prev)/7,q-(after-p)/7,q,6)
        smooth.extend(section[:-1])
    smooth.append(vectors[-1])
    rings=[]
    normal=None
    for i,p in enumerate(smooth):
        way=(smooth[min(i+1,len(smooth)-1)]-smooth[max(0,i-1)]).normalized()
        if normal is None:
            _,normal,_=vec_basis(way)
        normal=(normal-normal.dot(way)*way).normalized()
        binormal=way.cross(normal)
        t=i/(len(smooth)-1)
        r=radius if isinstance(radius,(float,int)) else radius[0]*(1-t)+radius[1]*t
        rings.append([p+r*(normal*cos(2*pi*j/sides)+binormal*sin(2*pi*j/sides)) for j in range(sides)])
    if hollow:
        inner = [[p+(v-p)*.82 for v in row] for p,row in zip(smooth,rings)]
        rings.extend(reversed(inner))
    return polygon_loft(rings,mat,0,hollow)

def straight(p,q,r,mat=cast):
    p,q=Vector(p),Vector(q)
    return cylinder((p+q)*.5,q-p,r,(q-p).length,mat,12,.002)

def subtract(obj,tool):
    select(obj)
    mod=obj.modifiers.new('Bore through casting','BOOLEAN')
    mod.operation='DIFFERENCE'
    mod.object=tool
    bpy.ops.object.modifier_apply(modifier=mod.name)
    bpy.data.objects.remove(tool,do_unlink=True)

def assembly(name, nested_under=None):
    key=name.removeprefix('RAK-')
    if key not in groups:
        empty=bpy.data.objects.new(f'RAK-{key}',None)
        bpy.context.collection.objects.link(empty)
        groups[key]=empty
    empty=groups[key]
    if nested_under:
        empty.parent=assembly(nested_under)
    return empty

def register_recipe(recipe):
    nested_recipes[recipe['id']]=recipe

def remove_part(id):
    match=next((p for p in parts if p['id']==id),None)
    if match is None:
        raise ValueError(f'Cannot replace missing part: {id}')
    parts.remove(match)
    bpy.data.objects.remove(bpy.data.objects[id],do_unlink=True)

def reparent_part(id,parent,nested_under=None,role=None,xray=None):
    part=next(p for p in parts if p['id']==id)
    obj=bpy.data.objects[id]
    owner=assembly(parent,nested_under)
    obj.parent=owner
    part.update(parent=owner.name,rakitan=owner.name)
    if role is not None:
        obj['role']=role
        part['role']=role
    if xray is not None:
        obj['xray_shell']=xray
        part['xray_shell']=xray
    return obj

def add(group, suffix, name, shapes, sources, note='', status='ESTIMATED', origin=None,
        xray=False, direction=None, parent=None, nested_under=None, role=None, oem=None,
        quantity=1):
    id=f'EXT-{group}-{suffix:02d}'
    owner=assembly(parent or group,nested_under)
    if any(p['id']==id for p in parts):
        raise ValueError(f'Duplicate exterior ID: {id}')
    if not isinstance(shapes,list):
        shapes=[shapes]
    bpy.ops.object.select_all(action='DESELECT')
    for obj in shapes:
        obj.select_set(True)
    obj=shapes[0]
    bpy.context.view_layer.objects.active=obj
    if len(shapes)>1:
        bpy.ops.object.join()
    bpy.ops.object.transform_apply(location=False, rotation=True, scale=True)
    if origin is None:
        bpy.ops.object.origin_set(type='ORIGIN_GEOMETRY',center='BOUNDS')
    else:
        bpy.context.scene.cursor.location=world(origin)
        bpy.ops.object.origin_set(type='ORIGIN_CURSOR')
    obj.name=id
    obj.data.name=id
    obj.parent=owner
    obj['id']=id
    obj['label']=name
    obj['xray_shell']=xray
    obj['evidence_status']=status
    if role:
        obj['role']=role
    bpy.context.view_layer.update()
    verts=[obj.matrix_world @ v.co for v in obj.data.vertices]
    packed=[(v.x,v.z,-v.y) for v in verts]
    low=[round(min(v[i] for v in packed),6) for i in range(3)]
    high=[round(max(v[i] for v in packed),6) for i in range(3)]
    parts.append(dict(id=id, name=name, nama=name, parent=owner.name, rakitan=owner.name,
                   count=quantity, jumlah=quantity, status=status, source_refs=sources, sumber=sources,
                   model_dimensions_m=[round(b-a,6) for a,b in zip(low,high)],
                   bounds_m=[low,high], ukuran_oem=None, nomor_oem=oem, role=role, xray_shell=xray,
                   note=note or 'Bentuk/tata letak dari tampak yang dikutip. Detail ukuran model diperkirakan.',
                   direction=direction))
    return obj

