    installModels(results);
    if (!roots[0] && !roots[1]) throw new Error('Kedua model 3D gagal dimuat. Buka Komponen untuk melihat inventaris.');
    if (!roots[0] || !roots[1]) {
      $('loading').textContent = 'Sebagian aset 3D gagal dimuat. Inventaris komponen tetap tersedia.';
    } else $('loading').hidden = true;
