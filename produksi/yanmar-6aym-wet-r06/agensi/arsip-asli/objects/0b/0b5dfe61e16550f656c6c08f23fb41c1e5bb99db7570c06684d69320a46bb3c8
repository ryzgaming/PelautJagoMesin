def cooler(center, length, w, h, label, sources, id, group='COOLING'):
    x,y,z=center
    edge=[(x-w*.48,y-h*.32),(x-w*.41,y-h*.49),(x+w*.33,y-h*.49),
          (x+w*.49,y-h*.31),(x+w*.47,y+h*.31),(x+w*.32,y+h*.50),
          (x-w*.33,y+h*.50),(x-w*.48,y+h*.35)]
    reach=length/2
    shape=prism(edge,'z',z-reach,z+reach,cover,.014)
    forms=[shape,box((x-w*.47,y,z),(.024,.030,length*.96),rib,.004)]
    for s in (-1,1):
        facez=z+s*(reach+.019)
        forms += [prism(edge,'z',*sorted((z+s*(reach-.013),facez)),cast,.009),
              cylinder((x,y,facez+s*.011),Z,min(w,h)*.44,.034,cover,44)]
        for n in range(8):
            a=(n+.5)*pi/4
            forms.append(bolt((x+w*.44*cos(a),y+h*.45*sin(a),facez+s*.018),(0,0,s),.011))
    for i in range(9):
        zz=z+(i-4)*length*.103
        for s in (-1, 1):
            forms.append(straight((x+s*w*.452,y-h*.235,zz),(x+s*w*.357,y-h*.463,zz),.010,rib))
    for s in (-1,1):
        forms.append(box((x+s*w*.469,y-h*.035,z),(.021,.019,length*.91),rib,.004))
    return add(group,id,label,forms,sources,xray=True,direction=(0,1,0))

