gd = Part("EXT-GUARD-01", "Guard kawat damper (O 0.652 m)", "DEPAN", YEL, "ESTIMATED",
          SRC_D01F + " (lingkaran guard O 0.652 m); P23 (guard kawat spiral kuning, marine)", "jumlah cincin kawat ILLUSTRATIVE")
for i, rr in enumerate([0.326, 0.300, 0.272, 0.244, 0.216, 0.188, 0.160, 0.132, 0.104, 0.076]):
    gd.sweep([V((2.085, rr * math.sin(2 * math.pi * k / 72), rr * math.cos(2 * math.pi * k / 72))) for k in range(72)], 0.004, n=6, closed=True)
for xx in (1.96, 2.0, 2.04):
    gd.sweep([V((xx, 0.326 * math.sin(2 * math.pi * k / 72), 0.326 * math.cos(2 * math.pi * k / 72))) for k in range(72)], 0.004, n=6, closed=True)
gd.sweep([V((1.945, 0.33 * math.sin(2 * math.pi * k / 72), 0.33 * math.cos(2 * math.pi * k / 72))) for k in range(72)], 0.012, n=8, closed=True)
for k in range(8):
