                p.box(BP(s, x - (0 if s > 0 else BANK_OFF) + dx, 0.47, 0.168), (0.05, 0.26, 0.03), R=R_, bev=0.008)   # boss baut kepala di dinding bank
        p.box(BP(s, 0.94, 0.60, 0.165), (1.88, 0.03, 0.035), R=R_, bev=0.006)            # bibir deck
p.finish()

for s, tag in ((1, "R"), (-1, "L")):
