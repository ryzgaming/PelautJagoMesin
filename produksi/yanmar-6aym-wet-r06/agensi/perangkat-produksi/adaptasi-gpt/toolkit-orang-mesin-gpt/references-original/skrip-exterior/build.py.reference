         SRC_D01S + "; datum.block (x 0..1.883, V 60 INFERRED, deck dari pita kepala silinder)",
         "lebar crankcase +-0.47 dan profil lembah V ESTIMATED/ILLUSTRATIVE (datum.block.width UNKNOWN)")
