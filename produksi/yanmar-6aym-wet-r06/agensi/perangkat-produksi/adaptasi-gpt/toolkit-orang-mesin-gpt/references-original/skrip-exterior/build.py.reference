# ---------------- simpan ----------------
for o in scene.objects: o.select_set(False)
tris = 0
dg = bpy.context.evaluated_depsgraph_get()
for o in scene.objects:
    if o.type == "MESH":
        me = o.evaluated_get(dg).to_mesh()
        me.calc_loop_triangles(); tris += len(me.loop_triangles)
        o.evaluated_get(dg).to_mesh_clear()
print("OBJECTS", sum(1 for o in scene.objects if o.type == "MESH"), "TRIS", tris)
os.makedirs(os.path.join(OUT, "assemblies"), exist_ok=True)
for aid, A in ASM.items():
    for b in A["bagian"].values():
        for ps in b["posisi"]:
            ob = bpy.data.objects[ps["object_id"]]
            ob["explode_dir"] = ps["arah"]; ob["explode_dist_m"] = ps["jarak_m"]; ob["explode_order"] = ps["urutan"]; ob["assembly"] = aid; ob["part_no"] = b["no"]
        for oid in b["object_ids"]:
            for it in INV:
                if it["id"] == oid: it["rakitan_eksplor"] = aid; it["no_posisi_model"] = b["no"]
    for oid in A["acuan"]["object_ids"]:
        bpy.data.objects[oid]["assembly"] = aid; bpy.data.objects[oid]["part_no"] = A["acuan"]["no"]; bpy.data.objects[oid]["explode_dist_m"] = 0.0
    out = dict(A); out["bagian"] = [A["bagian"][k] for k in sorted(A["bagian"])]
    ac = [b for b in out["bagian"] if b["no"] == A["acuan"]["no"]][0]
    ac["object_ids"] = list(A["acuan"]["object_ids"])
    ac["posisi"] = [dict(object_id=o, arah=[0, 0, 0], jarak_m=0.0, urutan=0) for o in ac["object_ids"]]
    out["catatan"] = "Nomor = nomor posisi model (bukan nomor OEM; parts book 3512C tidak publik). arah dalam koordinat dunia datum/glTF (m, +Y atas, +X depan, +Z kanan). jarak_m = pergeseran pada eksplor penuh; urutan = urutan pelepasan (1 pertama). Tabrakan dengan rakitan lain di luar rakitan ini tidak diperiksa."
    json.dump(out, open(os.path.join(OUT, "assemblies", aid + ".json"), "w"), ensure_ascii=False, indent=1)
bpy.ops.wm.save_as_mainfile(filepath=os.path.join(OUT, "exterior.blend"))
bpy.ops.export_scene.gltf(filepath=os.path.join(OUT, "exterior.glb"), export_format="GLB", export_apply=True, export_yup=True, export_extras=True)
json.dump(dict(model="Caterpillar 3512C HD marine propulsion - eksterior", sistem_koordinat="datum.json (m, +Y atas, +X depan, +Z kanan, asal sumbu crank di muka belakang blok)",
               segitiga_total=tris, objek_mesh=len(INV), bank_offset_kiri_m=BANK_OFF, item=INV),
          open(os.path.join(OUT, "inventory.json"), "w"), ensure_ascii=False, indent=1)
