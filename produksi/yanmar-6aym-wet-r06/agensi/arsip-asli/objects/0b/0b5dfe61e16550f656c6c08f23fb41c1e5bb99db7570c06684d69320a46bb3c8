# Flywheel, SAE face openings and ribbed bellhousing.
def clean_boolean(obj):
    import bmesh
    mesh = bmesh.new()
    mesh.from_mesh(obj.data)
    bmesh.ops.remove_doubles(mesh, verts=list(mesh.verts), dist=.00018)
    bmesh.ops.dissolve_degenerate(mesh, edges=list(mesh.edges), dist=.00012)
    bmesh.ops.recalc_face_normals(mesh, faces=list(mesh.faces))
    mesh.to_mesh(obj.data)
    mesh.free()
    obj.data.update()

def drill_circle(obj, x, n, pcd, radius, depth=.035):
    for i in range(n):
        angle=2*pi*i/n
        subtract(obj,cylinder((x,pcd/2*cos(angle),pcd/2*sin(angle)),X,radius,depth,black,16,0))
    clean_boolean(obj)

def drilled_annulus(x, depth, outer, inner, pcd, hole_r, count, mat):
    # Build an annular sector around each hole and weld shared sector edges.
    verts, faces = [], []
    step = 2*pi/count
    for i in range(count):
        angle = step*i
        phi0, phi1 = angle-step*.5, angle+step*.5
        perimeter=[]
        for edge, r in enumerate((outer, None, inner, None)):
            for j in range(4):
                t=j/4
                if edge==0 or edge==2:
                    phi=phi0+step*(t if edge==0 else 1-t)
                    rr=r
                else:
                    phi=phi1 if edge==1 else phi0
                    rr=outer+(inner-outer)*(t if edge==1 else 1-t)
                perimeter.append(Vector((rr*cos(phi),rr*sin(phi))))
        ctr=Vector((pcd*.5*cos(angle),pcd*.5*sin(angle)))
        bore=[ctr+(v-ctr).normalized()*hole_r for v in perimeter]
        first=len(verts)
        for xx in (x-depth/2,x+depth/2):
            verts += [(xx,*v) for boundary in (perimeter,bore) for v in boundary]
        for k in range(16):
            nxt=(k+1)%16
            a,b=first+k,first+nxt
            faces.extend([(a,b,b+16,a+16),(a+32,a+48,b+48,b+32),
                         (a+16,b+16,b+48,a+48)])
            if k<4 or 8<=k<12:
                faces.append((a,a+32,b+32,b))
    obj=mesh(verts,faces,mat)
    clean_boolean(obj)
    return obj

