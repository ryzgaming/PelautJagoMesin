"""Verify the r02 delivery tubes/fittings retain their exported geometry in r03."""
import argparse
import json
from pathlib import Path
import struct

import numpy as np

def geometry(path):
    with path.open('rb') as stream:
        magic,version,size=struct.unpack('<4sII',stream.read(12))
        assert magic==b'glTF' and version==2 and size==path.stat().st_size
        length,kind=struct.unpack('<I4s',stream.read(8))
        assert kind==b'JSON'
        model=json.loads(stream.read(length))
        length,kind=struct.unpack('<I4s',stream.read(8))
        assert kind==b'BIN\0'
        binary=stream.read(length)
    def values(index):
        accessor=model['accessors'][index]
        view=model['bufferViews'][accessor['bufferView']]
        dtype={5123:'<u2',5125:'<u4',5126:'<f4'}[accessor['componentType']]
        arity={'SCALAR':1,'VEC3':3}[accessor['type']]
        return np.frombuffer(binary,dtype,accessor['count']*arity,
                             view.get('byteOffset',0)+accessor.get('byteOffset',0)).reshape(-1,arity)
    def parts():
        for node in model['nodes']:
            if 'mesh' in node:
                mesh=model['meshes'][node['mesh']]
                location=np.asarray(node.get('translation',[0.,0.,0.]))
                catalog=[]
                for primitive in mesh['primitives']:
                    xyz=values(primitive['attributes']['POSITION'])+location
                    catalog.append((xyz,values(primitive['indices'])))
                yield node['name'],catalog
    return dict(parts())

parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('baseline',type=Path)
parser.add_argument('current',type=Path)
args=parser.parse_args()
before=geometry(args.baseline)
after=geometry(args.current)
ids=[f'EXT-FUEL-{i:02d}' for i in (*range(3,9), *range(13,19))]
missing=sorted(set(before)-set(after))
results={}
for i in ids:
    old=before[i]
    new=after[i]
    results[i]=(len(old)==len(new) and all(
        x.shape==y.shape and np.allclose(x,y,rtol=0,atol=1e-7) and np.array_equal(xi,yi)
        for (x,xi),(y,yi) in zip(old,new)))
print(json.dumps({'missing_r02_mesh_ids':missing,
    'same_position_attributes_and_indices':results,'unit':'m','absolute_position_tolerance':1e-7,
    'baseline_mesh_count':len(before),'r03_mesh_count':len(after)},indent=2))
if missing or not all(results.values()):
    raise SystemExit(1)
