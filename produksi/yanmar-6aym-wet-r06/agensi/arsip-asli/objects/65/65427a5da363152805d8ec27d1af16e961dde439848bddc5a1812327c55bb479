def make(part, name, group, verts, faces, material, parent=None, pivot=(0,0,0), smooth=False, status="OBSERVED", dimensions=None, note=None):
    mesh = bpy.data.meshes.new(part)
    base = v(pivot)
    mesh.from_pydata([v(p)-base for p in verts],[],faces)
    bm = bmesh.new()
    bm.from_mesh(mesh)
    bmesh.ops.recalc_face_normals(bm,faces=list(bm.faces))
    bm.to_mesh(mesh)
    bm.free()
    mesh.update()
    obj = bpy.data.objects.new(part,mesh)
    scene.collection.objects.link(obj)
    obj.parent = parent or GROUPS[group]
    obj.location = base
    obj.data.materials.append(material)
    if smooth:
        for poly in mesh.polygons:
            poly.use_smooth = True
        for edge in mesh.edges:
            edge.use_edge_sharp = False
        mesh.set_sharp_from_angle(angle=.67)
    obj["part_label"] = name
    obj["evidence_status"] = status
    obj["source"] = SOURCES[group]
    ITEMS.append(dict(id=part,name=name,assembly='RAK-INT-'+group,node=part,parent=obj.parent.name,part_number=None,quantity=1,status=status,source_refs=[SOURCES[group]],dimensions=dimensions or {},notes=note or "Detail ukuran dan radius tepi belum ditetapkan oleh gambar berdimensi.",appearance_material=material.name))
    return obj

def axis_coords(axis, center, h, r, a):
    u,w = r*math.cos(a),r*math.sin(a)
    x,y,z = center
    return ((x+h,y+u,z+w),(x+u,y+h,z+w),(x+u,y+w,z+h))[axis]

def lathe(part,name,group,axis,center,profile,material,parent=None,pivot=None,n=48,closed=True,arc=TAU,begin=0,**meta):
    full = math.isclose(arc,TAU)
    count = n if full else n+1
    verts = []
    for h,r in profile:
        for i in range(count):
            verts.append(axis_coords(axis,center,h,r,begin+arc*i/n))
    faces = []
    rows = len(profile)
    for j in range(rows if closed else rows-1):
        for i in range(n):
            u,w = j*count,((j+1)%rows)*count
            i1 = (i+1)%count
            faces.append((u+i,u+i1,w+i1,w+i))
    if not closed:
        faces += [tuple(range(count)),tuple((rows-1)*count+i for i in reversed(range(count)))]
    elif not full:
        faces += [tuple(j*count for j in range(rows)),tuple(j*count+n for j in reversed(range(rows)))]
    return make(part,name,group,verts,faces,material,parent,pivot or center,True,**meta)

def cyl(part,name,group,axis,center,r,width,material,parent=None,n=48,**meta):
    b = min(.001,width*.13,r*.12)
    return lathe(part,name,group,axis,center,[(-width/2,r-b),(-width/2+b,r),(width/2-b,r),(width/2,r-b)],material,parent,n=n,closed=False,**meta)

def ring(part,name,group,axis,center,inner,outer,width,material,parent=None,n=48,arc=TAU,begin=0,**meta):
    return lathe(part,name,group,axis,center,[(-width/2,inner),(-width/2,outer),(width/2,outer),(width/2,inner)],material,parent,n=n,arc=arc,begin=begin,**meta)

def prism(part,name,group,axis,center,coords,width,material,parent=None,**meta):
    i,j,k = center
    n = len(coords)
    verts = []
    for a in [-width/2,width/2]:
        for b,c in coords:
            verts.append(((i+a,j+b,k+c),(i+b,j+a,k+c),(i+b,j+c,k+a))[axis])
    faces = [tuple(reversed(range(n))),tuple(n+i for i in range(n))]
    faces += [(i,(i+1)%n,(i+1)%n+n,i+n) for i in range(n)]
    return make(part,name,group,verts,faces,material,parent,center,**meta)

def beam(part,name,group,a,b,r,material,parent=None,n=16,**meta):
    center = tuple((q+w)/2 for q,w in zip(a,b))
    length = (v(b)-v(a)).length
    ob = cyl(part,name,group,1,center,r,length,material,parent,n=n,**meta)
    ob.rotation_mode = "QUATERNION"
    ob.rotation_quaternion = (v(b)-v(a)).normalized().to_track_quat('Z','Y')
    return ob

def curve_tube(part,name,group,points,r,material,parent=None,ns=8,**meta):
    verts = []
    for j,(x,y,z) in enumerate(points):
        p = Vector((x,y,z))
        t = Vector(points[min(j+1,len(points)-1)])-Vector(points[max(j-1,0)])
        t.normalize()
        axis = Vector((0,1,0)) if abs(t.y)<.95 else Vector((1,0,0))
        u = t.cross(axis).normalized()
        w = t.cross(u)
        verts.extend(tuple(p+r*(u*math.cos(TAU*k/ns)+w*math.sin(TAU*k/ns))) for k in range(ns))
    faces = [tuple(reversed(range(ns)))]
    for j in range(len(points)-1):
        faces.extend((j*ns+k,j*ns+(k+1)%ns,(j+1)*ns+(k+1)%ns,(j+1)*ns+k) for k in range(ns))
    faces.append(tuple((len(points)-1)*ns+k for k in range(ns)))
    return make(part,name,group,verts,faces,material,parent,points[0],True,**meta)

def mount_bolt(part,name,group,x,y,z,parent=None,r=.010,width=.017):
