from water_drive_spec import FRESH_GEAR, SEA_GEAR, FRONT_CAM_TEETH, ALT_TEETH, FRESH_TEETH, SEA_TEETH, FIP_TEETH, CRANK_REAR_TEETH, OIL_GEAR_TEETH
