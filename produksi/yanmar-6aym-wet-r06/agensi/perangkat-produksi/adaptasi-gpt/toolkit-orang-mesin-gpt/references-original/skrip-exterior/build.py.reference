ac.bolt_circle((1.468, 1.06, 0), (1, 0, 0), 0.085, 8)
ac.finish()
for s, tag in ((1, "R"), (-1, "L")):
    im = Part(f"EXT-INLETMAN-{tag}", f"Inlet air manifold dan elbow inlet per silinder bank {'kanan' if s>0 else 'kiri'}", "AFTERCOOLER", YEL, "ESTIMATED" if s > 0 else "ILLUSTRATIVE",
              SRC_D02R + " (menara/elbow tegak dari rumah atas ke tiap kepala, baris T-fitting); " + SRC_D01S + ("; P26 (elbow tegak bank kiri, genset)" if s < 0 else ""),
              "6 elbow per bank; diameter 0.10 m ESTIMATED dari render D02" + ("; elbow dan badan T: " + LNOTE if s < 0 else ""))
    im.box((0.89 - (0 if s > 0 else BANK_OFF / 2), 0.925, s * 0.265), (1.56 + (0 if s > 0 else BANK_OFF), 0.075, 0.10), bev=0.02)
    for x in CYLX:
        cx = x - (0 if s > 0 else BANK_OFF)
        u, n = bank(s)
        st = BP(s, cx, 0.78, -0.115)
        path = fillet([st, st + u * 0.05, V((cx, 0.90, s * 0.265))], 0.04, 6)
        im.sweep(path, 0.048, n=18)
        im.cyl(st + u * 0.008, u, 0.066, 0.016, n=18, bev=0.003)
        im.bolt_circle(st + u * 0.016, u, 0.056, 4, r=0.008, h=0.008, ang0=math.pi / 4)
        im.cyl((cx, 0.925, s * 0.265), (1, 0, 0), 0.058, 0.11, n=18, bev=0.006)   # badan T
    im.finish()

sh = Part("EXT-SHIELD-01", "Heat shield atas (penutup abu-abu) di atas aftercooler dan jalur buang", "AFTERCOOLER", SHD, "ESTIMATED",
          SRC_D01S + " (garis atas miring X 0.04..1.687, puncak Y 1.398; datum.exhaust_manifold.top_shield_envelope_side); " + SRC_D02R,
