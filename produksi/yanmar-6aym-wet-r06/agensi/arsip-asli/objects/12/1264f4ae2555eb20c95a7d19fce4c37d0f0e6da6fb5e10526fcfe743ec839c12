def figure(image,name, box=(FIG_X,FIG_Y,FIG_W,FIG_H)):
    ob=Image.open(RAW/(name+".png")).convert("RGBA")
    assert ob.getchannel('A').getbbox(), f"Empty render {name}"
    x,y,w,h=box
    im=ob.resize((w,h),Image.Resampling.LANCZOS)
    image.paste(im,(x,y),im)
    return lambda i: (x+marks[name][str(i)][0]*w/ob.width,y+marks[name][str(i)][1]*h/ob.height)

def point(d,x,y):
    d.ellipse((x-6,y-6,x+6,y+6),fill=GREEN,outline=PAPER,width=2)

def spread(rows,min_gap,low,high):
    ordered=sorted(rows,key=lambda item:item[1])
    ys=[]
    for item in ordered:
        at=max(low,item[1],ys[-1]+min_gap if ys else low)
        ys.append(at)
    if ys and ys[-1]>high:
        ys[-1]=high
        for i in list(range(len(ys)-1))[::-1]:
            ys[i]=min(ys[i],ys[i+1]-min_gap)
    return list(zip(ordered,ys))

def captions(d,project,mapping,side,low=322,high=1333,gap=60):
    coords=[(i,*project(i),title) for i,title in mapping.items()]
    arranged=spread([(i,y,x,title) for i,x,y,title in coords],gap,low,high)
    left=side=="left"
    for (n,y,x,label),dest_y in arranged:
        start=328 if left else 907
        end=382 if left else 863
        via=430 if left else 811
        if abs(x-via)>40:
            d.line((start,dest_y,end,dest_y,via,y,x,y),fill=GREEN,width=2)
        else:
            d.line((start,dest_y,end,dest_y,x,y),fill=GREEN,width=2)
        point(d,x,y)
        if n!=99:
            nx=87 if left else 936
            d.rounded_rectangle((nx-18,dest_y-18,nx+28,dest_y+17),radius=9,fill=PANEL)
            d.text((nx+5,dest_y),f"{n:02d}",font=font(16,True),fill=GREEN,anchor="mm")
            tx=125 if left else 976
        else:
            tx=87 if left else 915
        for k,line in enumerate(label.split("\n")):
            d.text((tx,dest_y+(k-(len(label.split("\n"))-1)/2)*27),line,
                   fill=INK,font=font(22,True),anchor="lm")

