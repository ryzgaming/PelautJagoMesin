"""Track stable exterior selections and nested recipe IDs between R03 and R04."""
import argparse
import json
from pathlib import Path

parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('r03',type=Path)
parser.add_argument('r04',type=Path)
args=parser.parse_args()

def selections(workspace):
    path=workspace/'model/exterior/inventory.json'
    return {part['id'] for part in json.loads(path.read_text())['components']}

def nested(workspace):
    recipes={}
    for path in (workspace/'model/assemblies').glob('*.json'):
        recipe=json.loads(path.read_text())
        owner=recipe.get('parent_rakitan') or recipe.get('parent_assembly') or recipe.get('parent')
        if owner:
            recipes[recipe['id']]=recipe['acuan']['object_ids'][0]
    return recipes

old_ids=selections(args.r03)
new_ids=selections(args.r04)
old_recipes=nested(args.r03)
new_recipes=nested(args.r04)
retired=old_ids-new_ids
lost_recipes=old_recipes.keys()-new_recipes.keys()
changed_anchors={id for id in old_recipes.keys() & new_recipes.keys() if old_recipes[id]!=new_recipes[id]}
print(json.dumps({'r03_meshes':len(old_ids),'r04_meshes':len(new_ids),
    'retired_meshes':sorted(retired),'new_meshes':sorted(new_ids-old_ids),
    'r03_nested_count':len(old_recipes),'r04_nested_count':len(new_recipes),
    'lost_nested_recipe_ids':sorted(lost_recipes),'changed_nested_anchors':sorted(changed_anchors),
    'new_nested_recipe_ids':sorted(new_recipes.keys()-old_recipes.keys())
},indent=2))
if retired!={'EXT-COOLING-07'} or lost_recipes or changed_anchors:
    raise SystemExit(1)
