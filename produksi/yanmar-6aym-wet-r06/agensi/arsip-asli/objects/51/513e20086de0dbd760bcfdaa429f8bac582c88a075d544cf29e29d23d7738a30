import json, math, struct, sys, collections
from pathlib import Path
import numpy as np
p=Path(sys.argv[1])
with p.open('rb') as f:
 f.read(12)
 n,_=struct.unpack('<2I',f.read(8))
 j=json.loads(f.read(n))
 n,_=struct.unpack('<2I',f.read(8))
 data=f.read(n)
def accessor(i):
 a=j['accessors'][i]
 v=j['bufferViews'][a['bufferView']]
 t={5123:'<u2',5125:'<u4',5126:'<f4'}[a['componentType']]
 m={'SCALAR':1,'VEC3':3}[a['type']]
 z=v.get('byteOffset',0)+a.get('byteOffset',0)
 return np.frombuffer(data,t,a['count']*m,z).reshape(-1,m)
nodes=j['nodes']
parent={k:i for i,n in enumerate(nodes) for k in n.get('children',[])}
low=np.full(3,np.inf)
high=-low
counts=collections.Counter()
tiny={}
for i,n in enumerate(nodes):
 if 'mesh' not in n:
  continue
 assert nodes[parent[i]]['name'].startswith('RAK-')
 assert not set(n).intersection({'rotation','scale','matrix'})
 for prim in j['meshes'][n['mesh']]['primitives']:
  xyz=accessor(prim['attributes']['POSITION'])
  node_xyz=xyz+np.asarray(n.get('translation',[0,0,0]))
  low=np.minimum(low,np.min(node_xyz,axis=0))
  high=np.maximum(high,np.max(node_xyz,axis=0))
  ids=accessor(prim['indices']).reshape(-1,3)
  a,b,c=np.moveaxis(xyz[ids],1,0)
  areas=np.linalg.norm(np.cross(b-a,c-a),axis=1)*.5
  count=sum(areas<1e-12)
  if count:
   tiny[n['name']]=tiny.get(n['name'],0)+int(count)
  counts['triangles']+=len(ids)
  counts['render_vertices']+=len(xyz)
  counts['primitives']+=1
inventory=json.loads((p.parent/'inventory.json').read_text())
assert {n['name'] for n in nodes if 'mesh' in n} == {part['id'] for part in inventory['components']}
print(json.dumps(dict(bbox_m=[low.tolist(),high.tolist()],dimensions_m=(high-low).tolist(),**counts,
    meshes=len(j['meshes']),nodes=len(nodes),tiny_triangles_lt_1e12=tiny),indent=2))
