for zz in (-0.21, 0.21):
    for yy in (0.61, 0.87): pl.bolt((2.396, yy, zz), (1, 0, 0), r=0.01, h=0.008)
pl.finish()
asm_part("EXT-HX", 9, "Pelat penutup depan berbentuk X (dekoratif, tanpa logo)", "OBSERVED", "P23 (pelat X di depan heat exchanger)", "pelindung dan penanda muka depan heat exchanger; ikut dilepas bersama tutup depan")
asm_pos("EXT-HX", 9, "EXT-HEXPLATE-01", (1, 0, 0), 0.33, 6)
for s, tag in ((1, "R"), (-1, "L")):
    hz = Part(f"EXT-SELANG-{tag}", f"Selang karet hitam heat exchanger {'kanan' if s>0 else 'kiri'}", "PENDINGIN", RUB, "OBSERVED",
              "P23 (dua selang hitam di muka heat exchanger)", "rute ESTIMATED")
    pts = [V((2.36, 0.93, s * 0.27)), V((2.395, 0.90, s * 0.27)), V((2.40, 0.64, s * 0.27)), V((2.36, 0.56, s * 0.36)), V((2.30, 0.54, s * 0.43))]
    hz.sweep(fillet(pts, 0.06, 8), 0.034, n=16)
    for q in (pts[0], pts[-1]): hz.cyl(q, (1, 0, 0) if q is pts[0] else (0, 0, s), 0.04, 0.03, n=16, m=STL)
    hz.finish()

# ================= RAKITAN: POMPA AIR + PIPA =================
def pump(pid, nama, c, r, depth, status, src, cat, m=YEL):
    p = Part(pid, nama, "POMPA", m, status, src, cat)
    p.lathe([(0.0001, 0.0), (r * 0.6, 0.0), (r, depth * 0.25), (r, depth * 0.8), (r * 0.7, depth), (0.0001, depth)], c, (1, 0, 0), n=36)
    endp, tp, rp = volute(p, V(c) + V((depth * 0.5, 0, 0)), (0, 0, 1), (0, 1, 0), (1, 0, 0), r * 0.85, r * 1.15, r * 0.18, r * 0.32, -2 * math.pi * 0.8, 0.0, m)
    p.bolt_circle(V(c) + V((depth, 0, 0)), (1, 0, 0), r * 0.55, 6, r=0.009)
    return p, endp, tp, rp

jw, _, _, _ = pump("EXT-POMPAJW-01", "Jacket water pump (digerakkan roda gigi) depan kanan bawah", (1.93, -0.047, 0.427), 0.10, 0.11, "INFERRED",
                   "D01 hlm. 2, D02 hlm. 1 (jacket water pump gear-driven); " + SRC_D01F + " (siku pipa besar kanan (y -0.047, z 0.427)); " + SRC_D02R,
                   "identitas JW vs auxiliary tidak berlabel (datum INFERRED); ukuran ILLUSTRATIVE")
jw.finish()
