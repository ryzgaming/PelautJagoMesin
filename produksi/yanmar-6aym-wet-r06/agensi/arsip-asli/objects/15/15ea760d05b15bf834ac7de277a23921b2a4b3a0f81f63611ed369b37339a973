function updateNav() {
  for (const node of document.querySelectorAll('[data-mode]')) node.setAttribute('aria-pressed', String(node.dataset.mode === state.mode));
  $('xray').setAttribute('aria-pressed',String(state.xray));
  $('spread-box').hidden = state.mode !== 'overview';
  document.body.classList.toggle('overview-open',state.mode === 'overview');
}
function changeMode(mode) {
  if (!data) return;
  leaveDiagram();
  state.mode = mode;
  if (mode !== 'operation') { state.running = false; state.angle = 0; }
  if (['home','overview','systems','operation'].includes(mode)) {
    state.poseOverview = mode === 'overview';
    state.selected = null;
    state.isolated = false;
  }
  updateNav();
  if (mode === 'parts') showParts();
  else if (mode === 'systems') showSystems();
  else if (mode === 'operation') showOperation();
  else if (mode === 'component') renderComponent(entries.get(state.selected));
  else if (mode === 'sources') showSources();
  else closePanel();
  applyPose();
  if (['home','overview','systems','operation'].includes(mode)) requestAnimationFrame(() => frame());
}

function applyPose() {
  if (!renderer || !roots) return;
  const spread = state.poseOverview && state.mode !== 'assembly' ? Number($('spread').value)/100 : 0;
  for (const [id, {object,base}] of groups) {
    const vector = spreadVectors[id.replace(/^RAK-(?:INT-)?/,'')];
    object.position.copy(base);
    if (vector) object.position.addScaledVector(new T.Vector3(...vector), spread);
    object.visible = state.mode !== 'assembly' || state.assemblyGroup === id;
  }
  for (const entry of entries.values()) {
    if (!entry.object) continue;
    const visible = state.mode === 'assembly' ? state.assemblyParts.has(entry.id)
      : !state.isolated || entry.id === state.selected;
    entry.object.visible = visible;
  }
  roots[1]?.traverse(object => {
    if (object.isMesh) object.visible = !object.userData.component ||
      state.xray || state.mode === 'assembly' || state.isolated ||
      entries.get(object.userData.component)?.id === state.selected;
  });
  for (const [mesh, {solid, transparent}] of shellMaterials) {
    mesh.material = state.xray ? transparent : solid;
  }
  applyKinematics();
  refreshHighlight();
}
function refreshHighlight() {
  if (!selectionBox) return;
  const selected = entries.get(state.selected)?.object;
  selectionBox.visible = Boolean(selected && selected.visible);
  if (!selectionBox.visible) return;
  selected.updateWorldMatrix(true,true);
  selectionBox.box.setFromObject(selected);
}

let motion;
function kinematicParts() {
  if (motion) return motion;
  if (!roots || !data.kinematics) return null;
  const config = data.kinematics.viewer;
  if (!config?.enabled || !Array.isArray(config.rotators) || !Array.isArray(config.cylinders)
      || !Number.isFinite(config.throw_m) || !Number.isFinite(config.rod_cc_m)
      || config.rod_cc_m <= config.throw_m) return null;
  const lookup = (id) => roots.map(root => root?.getObjectByName(id)).find(Boolean);
  const rotators = config.rotators.map(entry => ({...entry, object:lookup(entry.node)}));
  const cylinders = config.cylinders.map(entry => ({...entry, rod:lookup(entry.rod), piston:lookup(entry.piston)}));
  if (!rotators.length || !cylinders.length || rotators.some(({object, factor})=>!object || !Number.isFinite(factor))
      || cylinders.some(entry => !entry.rod || !entry.piston || !Number.isFinite(entry.phase_deg))) return null;
  for (const entry of rotators) entry.base = entry.object.quaternion.clone();
  for (const entry of cylinders) {
    entry.rodBase = entry.rod.quaternion.clone();
    entry.pistonBase = entry.piston.position.clone();
    entry.rodPosition = entry.rod.position.clone();
  }
  motion = {...config, rotators, cylinders, axis:new T.Vector3(1,0,0)};
  return motion;
}
function applyKinematics() {
  const config = kinematicParts();
  if (!config) return;
  const {axis,rotators,cylinders} = config;
  const rotation = new T.Quaternion();
  for (const {object,base,factor} of rotators) {
    object.quaternion.copy(base).premultiply(rotation.setFromAxisAngle(axis,state.angle * factor));
  }
  for (const entry of cylinders) {
    const phase = entry.phase_deg * Math.PI/180;
    const theta = state.angle + phase;
    const pin = (angle) => {
      const y = config.throw_m * Math.cos(angle);
      const z = -config.throw_m * Math.sin(angle);
      return {y,z,wrist:y+Math.sqrt(config.rod_cc_m ** 2-z ** 2)};
    };
    const start = pin(phase);
    const now = pin(theta);
    entry.rod.position.copy(entry.rodPosition);
    entry.rod.position.y += now.y-start.y;
    entry.rod.position.z += now.z-start.z;
    const offset = Math.atan2(-now.z,now.wrist-now.y) - Math.atan2(-start.z,start.wrist-start.y);
    entry.rod.quaternion.copy(entry.rodBase).premultiply(rotation.setFromAxisAngle(axis,offset));
    entry.piston.position.copy(entry.pistonBase);
    entry.piston.position.y += now.wrist-start.wrist;
  }
}
function frame() {
  if (!renderer || !roots) return;
  scene.updateMatrixWorld(true);
  const box = new T.Box3();
  for (const root of roots) root?.traverseVisible(object => {
    if (!object.isMesh) return;
    if (!object.geometry.boundingBox) object.geometry.computeBoundingBox();
    box.union(object.geometry.boundingBox.clone().applyMatrix4(object.matrixWorld));
  });
  if (box.isEmpty()) return;
  const target = box.getCenter(new T.Vector3());
  const radius = box.getSize(new T.Vector3()).length() / 2;
  const slope = Math.tan(T.MathUtils.degToRad(camera.fov/2));
  const direction = camera.position.clone().sub(controls.target).normalize();
  const right = camera.up.clone().cross(direction).normalize();
  const up = direction.clone().cross(right).normalize();
  let distance = .1;
  for (const x of [box.min.x,box.max.x]) for (const y of [box.min.y,box.max.y]) for (const z of [box.min.z,box.max.z]) {
    const delta = new T.Vector3(x,y,z).sub(target);
    const needed = Math.max(Math.abs(delta.dot(right))/(slope*camera.aspect),Math.abs(delta.dot(up))/slope);
    distance = Math.max(distance,delta.dot(direction)+needed*1.19);
  }
  controls.target.copy(target);
  camera.position.copy(target).addScaledVector(direction, distance);
  controls.minDistance = Math.max(.08,radius*.18);
  controls.maxDistance = Math.max(15,distance*3);
  controls.update();
}
function installModels(results) {
  roots = results.map(result => result.status === 'fulfilled' ? result.value.scene : null);
  for (const [i,root] of roots.entries()) {
    if (!root) continue;
    scene.add(root);
    root.updateMatrixWorld(true);
    root.traverse(object => {
      if (object.name.startsWith('RAK-')) groups.set(object.name,{object,base:object.position.clone()});
      const id = object.userData.id || object.name;
      const entry = entries.get(id);
      if (!entry) return;
      entry.object = object;
      object.traverse(mesh => {
        if (!mesh.isMesh) return;
        mesh.userData.component = id;
        if (i !== 0 || !entry.xray_shell) return;
        const hide = (material) => {
          const copy = material.clone();
          copy.transparent = true;
          copy.opacity = .18;
          copy.depthWrite = false;
          return copy;
        };
        shellMaterials.set(mesh,{solid:mesh.material,
          transparent:Array.isArray(mesh.material) ? mesh.material.map(hide) : hide(mesh.material)});
      });
    });
  }
  applyPose();
  frame();
}
function initializeViewport() {
  T = window.THREE;
  if (!T?.GLTFLoader || !T?.OrbitControls) throw new Error('Pustaka 3D tidak dapat dibuka.');
  const host = $('canvas');
  scene = new T.Scene();
  selectionBox = new T.Box3Helper(new T.Box3(),0x79ead0);
  selectionBox.visible = false;
  scene.add(selectionBox);
  camera = new T.PerspectiveCamera(35,1,.025,80);
  camera.position.set(2.25,1.5,-2.6);
  renderer = new T.WebGLRenderer({alpha:true,antialias:true,powerPreference:'high-performance'});
  renderer.outputEncoding = T.sRGBEncoding;
  renderer.setPixelRatio(Math.min(1.7,window.devicePixelRatio || 1));
  host.append(renderer.domElement);
  const ambient = new T.HemisphereLight(0xeaf8f6,0x5a4943,1.02);
  scene.add(ambient);
  for (const [x,y,z,color,intensity] of [[1,2,-3,0xfff5df,1.95],[-3,1,2,0xbbdce8,1.3],[4,1,2,0xffffff,.72]]) {
    const light = new T.DirectionalLight(color,intensity);
    light.position.set(x,y,z);
    scene.add(light);
  }
  controls = new T.OrbitControls(camera,renderer.domElement);
  controls.enableDamping = true;
  let start;
  const pointer = new T.Vector2();
  const raycaster = new T.Raycaster();
  renderer.domElement.addEventListener('pointerdown',event => {
    start = event.isPrimary && event.button === 0 ? [event.clientX,event.clientY] : null;
  });
  renderer.domElement.addEventListener('pointerup',event => {
    if (!start || Math.hypot(event.clientX-start[0],event.clientY-start[1])>6 || !roots) return;
    const rect = renderer.domElement.getBoundingClientRect();
    pointer.set(2*(event.clientX-rect.left)/rect.width-1,1-2*(event.clientY-rect.top)/rect.height);
    raycaster.setFromCamera(pointer,camera);
    const visible = [];
    for (const root of roots) root?.traverseVisible(mesh => {
      if (mesh.isMesh && mesh.userData.component) visible.push(mesh);
    });
    const hits = raycaster.intersectObjects(visible,false);
    const hit = hits.find(({object})=>!state.xray || !shellMaterials.has(object)) || hits[0];
    if (hit) select(hit.object.userData.component);
  });
  renderer.domElement.addEventListener('webglcontextlost',event=>{
    event.preventDefault();
    $('loading').textContent='Tampilan 3D terputus. Informasi komponen masih dapat dibuka.';
    $('loading').hidden=false;
  });
  renderer.domElement.addEventListener('webglcontextrestored',()=>{
    if (roots?.every(Boolean)) $('loading').hidden=true;
  });
  let oldAspect;
  new ResizeObserver(() => {
    if (!host.clientWidth || !host.clientHeight) return;
    const aspect = host.clientWidth/host.clientHeight;
    renderer.setSize(host.clientWidth,host.clientHeight,false);
    camera.aspect = aspect;
    camera.updateProjectionMatrix();
    if (!stopDiagram && state.mode !== 'component' && oldAspect && Math.abs(aspect-oldAspect) > .15) frame();
    oldAspect = aspect;
  }).observe(host);
  let before;
  renderer.setAnimationLoop((time) => {
    const delta = Math.min(.05,(time-(before ?? time))/1000);
    before = time;
    if (state.running) {
      state.angle = (state.angle + delta*.85)%(2*Math.PI);
      applyKinematics();
    }
    controls.update();
    renderer.render(scene,camera);
  });
}
async function start() {
  try {
    const embedded = $('embedded-data');
    if (embedded) data = JSON.parse(embedded.textContent);
    else {
      const response = await fetch('assets/data.json');
      if (!response.ok) throw new Error('Informasi komponen tidak dapat dibuka.');
      data = await response.json();
    }
    for (const entry of data.components) entries.set(entry.id,entry);
    state.system = data.systems[0]?.system;
    if (data.reviewApproved === true) $('review-status').hidden = true;
    initializeViewport();
    const loader = new T.GLTFLoader();
    const loadModel = (name) => {
      const asset = $('embedded-'+name);
      if (!asset) return loader.loadAsync('assets/'+name+'.glb');
      return new Promise((resolve,reject) => {
        const encoded = asset.textContent;
        const bytes = new Uint8Array(encoded.length/4*3-(encoded.endsWith('==') ? 2 : Number(encoded.endsWith('='))));
        const chunkSize = 64*1024;
        let write = 0;
        for (let index=0;index<encoded.length;index+=chunkSize) {
          const chunk = atob(encoded.slice(index,index+chunkSize));
          for (let offset=0;offset<chunk.length;offset++) bytes[write++]=chunk.charCodeAt(offset);
        }
        loader.parse(bytes.buffer,'',resolve,reject);
      });
    };
    const results = await Promise.allSettled(['exterior','internal'].map(loadModel));
    installModels(results);
    if (!roots[0] && !roots[1]) throw new Error('Kedua model 3D gagal dimuat. Buka Komponen untuk melihat inventaris.');
    if (!roots[0] || !roots[1]) {
      $('loading').textContent = 'Sebagian aset 3D gagal dimuat. Inventaris komponen tetap tersedia.';
    } else $('loading').hidden = true;
    if (state.mode === 'operation') showOperation();
    if (state.mode === 'component') renderComponent(entries.get(state.selected));
  } catch (error) {
    $('loading').textContent = error.message || 'Model 3D tidak dapat ditampilkan pada perangkat ini.';
  }
}
for (const node of document.querySelectorAll('[data-mode]')) node.addEventListener('click', () => changeMode(node.dataset.mode));
$('parts').addEventListener('click', () => changeMode('parts'));
$('sources').addEventListener('click', () => changeMode('sources'));
$('reset').addEventListener('click', () => {
  state.xray = false;
  state.running = false;
  state.angle = 0;
  $('spread').value = 50;
  $('spread-value').value = '50%';
  if (camera) camera.position.copy(controls.target).add(new T.Vector3(2.25,1.5,-2.6));
  changeMode('home');
});
$('close').addEventListener('click', () => state.mode === 'assembly' ? restoreDiagram() : closePanel());
$('xray').addEventListener('click',() => { state.xray = !state.xray; updateNav(); applyPose(); });
$('spread').addEventListener('input', () => { $('spread-value').value = $('spread').value + '%'; applyPose(); });
$('spread').addEventListener('change', () => frame());
window.addEventListener('keydown',event => {
  if (event.key !== 'Escape') return;
  if (state.mode === 'assembly') restoreDiagram();
  else if (!panel.hidden) closePanel();
});
