dm.lathe([(0.0001, 1.93), (0.10, 1.93), (0.10, 1.95), (0.24, 1.955), (0.245, 1.965), (0.245, 2.025), (0.24, 2.035), (0.10, 2.04), (0.08, 2.06), (0.0001, 2.06)], (0, 0, 0), (1, 0, 0), n=48)
for k in range(24):
    a = 2 * math.pi * k / 24
    dm.box((1.995, 0.243 * math.sin(a), 0.243 * math.cos(a)), (0.05, 0.012, 0.012), R=Matrix.Rotation(-a, 3, "X"))
dm.bolt_circle((2.06, 0, 0), (1, 0, 0), 0.06, 8, r=0.010)
