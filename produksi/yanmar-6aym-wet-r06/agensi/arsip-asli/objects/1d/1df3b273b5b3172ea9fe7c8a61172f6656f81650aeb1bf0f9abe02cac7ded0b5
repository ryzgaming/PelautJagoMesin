      const link = element('a', 'Buka sumber');
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      item.append(document.createTextNode(' · '), link);
    }
    list.append(item);
  }
  if (partReference && !catalogLinked) {
    const url = data.sources.find(({id})=>id==='D05')?.url;
