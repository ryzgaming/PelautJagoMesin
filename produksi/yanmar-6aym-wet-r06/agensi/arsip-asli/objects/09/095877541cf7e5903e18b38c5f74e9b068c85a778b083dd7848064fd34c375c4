  state.tour={index:0,elapsed:0,flow:state.flow,xray:state.xray,flowCut:state.flowCut};
  state.flowCut=false;
  state.running=play;
  state.angle=0;
  state.simTime=0;
  clearDriveClocks();
  state.xray=true;
  closePanel();
  setTourStage(0);
  updateNav();
}
function nextTour() {
  if (state.tour) setTourStage(state.tour.index+1);
}
function finishTour() {
  if (!state.tour) return;
  const {xray,flow,flowCut}=state.tour;
  state.tour=null;
  state.tourSpread=0;
  state.running=false;
  state.xray=xray;
  state.flowCut=flowCut;
  pickFlow(flow);
  applyPose();
  if (camera) {
    camera.position.copy(controls.target).add(new T.Vector3(...initialView));
    frame();
  }
  updateNav();
}
function resetOperation() {
  if (!activeEngineMode()) return;
  state.running=false;
  state.simTime=0;
  state.angle=0;
  clearDriveClocks();
  if (state.tour) setTourStage(0);
  applyPose();
  updateOperationDock();
}
function advanceSimulation(delta) {
  let stage=state.tour && tourStages[state.tour.index];
  if (stage) {
    state.tour.elapsed+=delta;
    const elapsed=state.tour.elapsed;
    if (elapsed>=stage.duration) {
      setTourStage(state.tour.index+1);
      stage=state.tour && tourStages[state.tour.index];
      if (!state.running) return;
    } else {
      if (!reducedMotion() && elapsed <= .95) moveTourCamera(Math.min(1,elapsed/.9));
      if (stage.spread) {
        const progress = state.tour.staticReveal ? 1 : Math.min(1,elapsed/stage.duration);
        state.tourSpread = stage.spread[0]+(stage.spread[1]-stage.spread[0])*progress;
        applyPose();
        frame();
      }
    }
  }
  if (!stage || stage.operate) {
    state.simTime+=delta;
    const step=delta*(stage?.speed || (state.enginePhase==='starting' ? starterRadiansPerSecond : crankRadiansPerSecond));
    if (state.enginePhase==='starting' && delta>0) state.starterEngaged=true;
    state.driveAngles.both+=step;
    state.driveAngles[state.enginePhase]+=step;
    state.angle=state.driveAngles.both%(4*Math.PI);
    applyKinematics();
    applyDrivetrain();
    updateFlowParticles();
  }
}
function initializeViewport() {
  T = window.THREE;
  if (!T?.GLTFLoader || !T?.OrbitControls) throw new Error('Pustaka 3D tidak dapat dibuka.');
  const host = $('canvas');
  clipPlane = new T.Plane();
  scene = new T.Scene();
  selectionBox = new T.Box3Helper(new T.Box3(),0x79ead0);
  selectionBox.visible = false;
  scene.add(selectionBox);
  camera = new T.PerspectiveCamera(35,1,.025,80);
  camera.position.set(...initialView);
  renderer = new T.WebGLRenderer({alpha:true,antialias:true,powerPreference:'high-performance'});
  renderer.outputEncoding = T.sRGBEncoding;
  renderer.localClippingEnabled = true;
  renderer.setPixelRatio(Math.min(1.7,window.devicePixelRatio || 1));
  host.append(renderer.domElement);
  const ambient = new T.HemisphereLight(0xeaf8f6,0x5a4943,1.02);
  scene.add(ambient);
  for (const [x,y,z,color,intensity] of [[1,2,-3,0xfff5df,1.95],[-3,1,2,0xbbdce8,1.3],[4,1,2,0xffffff,.72]]) {
    const light = new T.DirectionalLight(color,intensity);
    light.position.set(x,y,z);
    scene.add(light);
  }
  controls = new T.OrbitControls(camera,renderer.domElement);
  controls.enableDamping = true;
  let start;
  const pointer = new T.Vector2();
  const raycaster = new T.Raycaster();
  renderer.domElement.addEventListener('pointerdown',event => {
    start = event.isPrimary && event.button === 0 ? [event.clientX,event.clientY] : null;
  });
  renderer.domElement.addEventListener('pointerup',event => {
    if (!start || Math.hypot(event.clientX-start[0],event.clientY-start[1])>6 || !roots) return;
    const rect = renderer.domElement.getBoundingClientRect();
    pointer.set(2*(event.clientX-rect.left)/rect.width-1,1-2*(event.clientY-rect.top)/rect.height);
    raycaster.setFromCamera(pointer,camera);
    const hit = visibleIntersection(raycaster);
    if (hit) select(hit.object.userData.component);
  });
  renderer.domElement.addEventListener('webglcontextlost',event=>{
    event.preventDefault();
    $('loading').textContent='Tampilan 3D terputus. Informasi komponen masih dapat dibuka.';
    $('loading').hidden=false;
    filmLink($('loading'));
  });
  renderer.domElement.addEventListener('webglcontextrestored',()=>{
    if (roots?.every(Boolean)) $('loading').hidden=true;
  });
  let oldAspect;
  new ResizeObserver(() => {
    if (!host.clientWidth || !host.clientHeight) return;
    const aspect = host.clientWidth/host.clientHeight;
    renderer.setSize(host.clientWidth,host.clientHeight,false);
    camera.aspect = aspect;
    camera.updateProjectionMatrix();
    if ((state.mode !== 'component' || state.isolated) && oldAspect && Math.abs(aspect/oldAspect-1) > .04) {
      if (state.mode==='drives') focusDrive();
      else frame();
    }
    oldAspect = aspect;
  }).observe(host);
  let before;
  renderer.setAnimationLoop((time) => {
    const delta = Math.min(.05,(time-(before ?? time))/1000);
    before = time;
    if (state.running) advanceSimulation(delta);
    controls.update();
    renderer.render(scene,camera);
  });
}
async function start() {
  const params = new URLSearchParams(window.location?.search || '');
  const requested = params.get('part');
  const view = params.get('view');
  try {
    const embedded = $('embedded-data');
    if (embedded) data = JSON.parse(embedded.textContent);
    else {
      const response = await fetch('assets/data.json');
      if (!response.ok) throw new Error('Informasi komponen tidak dapat dibuka.');
      data = await response.json();
    }
    for (const entry of data.components) entries.set(entry.id,entry);
    for (const [id,recipe] of Object.entries(data.assemblies)) {
      if (!recipe.parent || !recipe.anchor) continue;
      const scope = {...recipe,id,content_name:recipe.content_name || groupName(id).toLocaleLowerCase('id-ID')};
      scopesById.set(id,scope);
    }
    for (const scope of scopesById.values()) for (const part of scope.parts) {
      const existing = scopesByPart.get(part.id);
      if (!existing || scope.parent === existing.id) scopesByPart.set(part.id,scope);
    }
    state.system = data.systems[0]?.system;
    if (data.reviewApproved === true) $('review-status').hidden = true;
    initializeViewport();
    const loader = new T.GLTFLoader();
    const loadModel = (name) => {
      const asset = $('embedded-'+name);
      if (!asset) return loader.loadAsync('assets/'+name+'.glb');
      return new Promise((resolve,reject) => {
        const encoded = asset.textContent;
        const bytes = new Uint8Array(encoded.length/4*3-(encoded.endsWith('==') ? 2 : Number(encoded.endsWith('='))));
        const chunkSize = 64*1024;
        let write = 0;
        for (let index=0;index<encoded.length;index+=chunkSize) {
          const chunk = atob(encoded.slice(index,index+chunkSize));
          for (let offset=0;offset<chunk.length;offset++) bytes[write++]=chunk.charCodeAt(offset);
        }
        loader.parse(bytes.buffer,'',resolve,reject);
      });
    };
    const results = await Promise.allSettled(['exterior','internal'].map(loadModel));
    installModels(results);
    installDrivetrain();
    installFlowModel();
    if (!roots[0] && !roots[1]) throw new Error('Kedua model 3D gagal dimuat. Buka Komponen untuk melihat inventaris.');
    if (!roots[0] || !roots[1]) {
      $('loading').textContent = 'Sebagian aset 3D gagal dimuat. Inventaris komponen tetap tersedia.';
    } else $('loading').hidden = true;
    if (activeEngineMode()) updateOperationDock();
    if (state.mode === 'component') renderComponent(entries.get(state.selected));
  } catch (error) {
    $('loading').textContent = error.message || 'Model 3D tidak dapat ditampilkan pada perangkat ini.';
    filmLink($('loading'));
  }
  const entry = componentEntry(requested);
  if (!entry) {
    if (['operation','tour','drives'].includes(view) && data) changeMode(view==='drives' ? 'drives' : 'operation');
    if (view==='drives' && driveViews.has(params.get('drive'))) selectDrive(params.get('drive'));
    if (view === 'tour' && renderer && roots?.some(Boolean)) beginTour(false);
    return;
  }
  select(entry.id);
  const scope = scopeFor(entry);
  if (!['section','exploded'].includes(view)) return;
  const section = view === 'section';
  if (section ? !scopeReady(scope) : !scopeInspectable(scope)) return;
  state.xray = section;
  openDiagram(entry,scope.id,{spread:!section});
  if (section) requestAnimationFrame(()=>{
    if (state.assemblyGroup === scope.id && !state.cutaway) toggleCutaway(scope);
  });
}
