labels={'BLOCK':'Block dan crankcase','HEADS':'Cylinder heads dan bonnet','OILPAN':'Carter oli',
        'FLYWHEEL':'Flywheel dan housing','FRONT':'Penggerak depan','INTAKE':'Udara masuk',
        'EXHAUST':'Turbocharger dan exhaust','COOLING':'Pendinginan','FUEL':'Injeksi bahan bakar',
        'LUBE':'Pelumasan','ELECTRIC':'Elektrik'}
anchors={'BLOCK':1,'HEADS':1,'OILPAN':1,'FLYWHEEL':1,'FRONT':1,'INTAKE':1,'EXHAUST':1,
         'COOLING':1,'FUEL':1,'LUBE':1,'ELECTRIC':1}
for group,empty in groups.items():
    if empty.parent or group not in anchors:
        continue
    entries=[p for p in parts if p['parent']==empty.name]
    for nested in nested_recipes.values():
        if nested.get('parent_rakitan')==empty.name:
            ids=set(nested['acuan']['object_ids'])
            entries.extend(p for p in parts if p['id'] in ids and p not in entries)
    entries.sort(key=lambda p:p['id'])
    anchor=anchors[group]
    view=([-1,0,0] if group=='FLYWHEEL' else [1,0,0] if group=='FRONT'
          else [0,-1,-1] if group=='OILPAN' else [.4,.7,-1 if group in ('INTAKE','FUEL','BLOCK','HEADS') else 1])
    view=list(Vector(view).normalized())
    sections=[]
    for n,p in enumerate(entries,1):
        direction=p['direction'] or (0,1,0)
        distance=.0 if n==anchor else (.40 if group in ('HEADS','COOLING','EXHAUST') else .28)
        order=n
        if group in ('HEADS','FUEL'):
            # Stagger duplicate directions so removable pieces do not stack at full extension.
            distance+=.018*(n-1) if n!=anchor else 0
            if group=='HEADS' and n>6:
                distance+=.15
                order=n-6
        sections.append({'no':n,'nama':p['name'],'object_ids':[p['id']],
             'posisi':[] if n==anchor else [{'object_id':p['id'],'arah':list(direction),
                                            'jarak_m':round(distance,3),'urutan':order}],
             'status':p['status'],'sumber':p['source_refs'],'fungsi':p['name'],
             'nomor_oem':p['nomor_oem'],'role':p['role'],'ukuran':p['ukuran_oem']})
    write_json(OUT.parent/'assemblies'/f'{empty.name}.json',{'id':empty.name,'nama':labels[group],
        'node_rakitan':empty.name,'acuan':{'no':anchor,'object_ids':[entries[anchor-1]['id']]},
        'diagram':{'arah_pandang':view,'atas':[0,1,0]},'bagian':sections,
        'notes':'Nomor posisi model. Lintasan ilustrasi, belum diperiksa untuk interferensi.'})
