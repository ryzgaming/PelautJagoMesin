"""Illustrative WET gear counts reproducing manual pump speeds at the 1,900 rpm bench condition."""
from math import hypot,sqrt,cos,sin,radians
CAM_CENTER_YZ=(.158,-.150)
ALT_CENTER_YZ=(.090755,-.289654)
FIP_CENTER_YZ=(.200,-.427)
FRONT_CAM_TEETH=48
ALT_TEETH=16
FRESH_TEETH=18
REAR_CAM_TEETH=48
FIP_TEETH=48
SEA_TEETH=29
IDLER_A_TEETH=24
FRONT_MODULE=2*hypot(ALT_CENTER_YZ[0]-CAM_CENTER_YZ[0],ALT_CENTER_YZ[1]-CAM_CENTER_YZ[1])/(FRONT_CAM_TEETH+ALT_TEETH)
FRONT_CAM_RADIUS=FRONT_MODULE*FRONT_CAM_TEETH/2
ALT_RADIUS=FRONT_MODULE*ALT_TEETH/2
FRESH_RADIUS=FRONT_MODULE*FRESH_TEETH/2
FIP_RADIUS=hypot(FIP_CENTER_YZ[0]-CAM_CENTER_YZ[0],FIP_CENTER_YZ[1]-CAM_CENTER_YZ[1])/2
SEA_RADIUS=FIP_RADIUS*SEA_TEETH/FIP_TEETH
FRESH_CENTER_YZ=(CAM_CENTER_YZ[0]+(FRONT_CAM_RADIUS+FRESH_RADIUS)*cos(radians(25)),
                 CAM_CENTER_YZ[1]+(FRONT_CAM_RADIUS+FRESH_RADIUS)*sin(radians(25)))
SEA_CENTER_Z=-.430
SEA_CENTER_Y=FIP_CENTER_YZ[0]+sqrt((FIP_RADIUS+SEA_RADIUS)**2-(SEA_CENTER_Z-FIP_CENTER_YZ[1])**2)
SEA_GEAR=(.057,SEA_CENTER_Y,SEA_CENTER_Z)
FRESH_GEAR=(1.354,*FRESH_CENTER_YZ)
