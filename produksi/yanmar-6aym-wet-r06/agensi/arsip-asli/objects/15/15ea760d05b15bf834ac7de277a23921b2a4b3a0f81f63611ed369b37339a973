'use strict';

const $ = (id) => document.getElementById(id);
const stage = $('stage');
const panel = $('panel');
const panelBody = $('panel-body');
const state = {mode:'home', selected:null, isolated:false, xray:false, system:null, angle:0, running:false, poseOverview:false};
const entries = new Map();
const groups = new Map();
const shellMaterials = new Map();
let T, scene, camera, controls, renderer, roots, data, stopDiagram, previousView, selectionBox;
const labels = {
  BLOCK:'Blok silinder', HEADS:'Kepala silinder', OILPAN:'Bak oli', FLYWHEEL:'Roda gila',
  FRONT:'Ujung peredam', INTAKE:'Pemasukan udara', EXHAUST:'Gas buang', FUEL:'Bahan bakar',
  COOLING:'Pendinginan', LUBE:'Pelumasan', ELECTRIC:'Kelistrikan', CRANK:'Poros engkol',
  MAIN:'Bantalan utama', PISTON:'Piston dan ring', ROD:'Batang penghubung', LINER:'Liner silinder',
  CAM:'Poros nok', VALVE:'Mekanisme katup', FUELINJ:'Injektor', TIMING:'Roda gigi timing',
  OILPUMP:'Pompa oli'
};
const systemLabels = {
  fuel:'Bahan bakar', lubrication:'Pelumasan', freshwater:'Air tawar', seawater:'Air laut',
  'intake-exhaust':'Udara dan gas buang', 'air-exhaust':'Udara dan gas buang', air_exhaust:'Udara dan gas buang'
};
// Vectors are in the shared meter datum. Parts on the same interface stay together.
const spreadVectors = {
  BLOCK:[0,0,0], HEADS:[0,.38,0], OILPAN:[0,-.35,0], FLYWHEEL:[-.43,0,0],
  FRONT:[.33,0,0], INTAKE:[0,.67,0], EXHAUST:[0,0,.41], FUEL:[0,0,-.42],
  COOLING:[.59,0,0], LUBE:[0,-.14,-.33], ELECTRIC:[-.44,0,-.28], CRANK:[0,0,0],
  MAIN:[0,-.13,0], PISTON:[0,.17,0], ROD:[0,.09,0], LINER:[0,.28,0],
  CAM:[0,0,.22], VALVE:[0,.55,0], FUELINJ:[0,.48,0], TIMING:[.12,0,0], OILPUMP:[0,-.19,0]
};

function element(tag, text, className) {
  const node = document.createElement(tag);
  if (text !== undefined) node.textContent = text;
  if (className) node.className = className;
  return node;
}
function button(text, handler, pressed) {
  const node = element('button', text);
  node.type = 'button';
  node.addEventListener('click', handler);
  if (pressed !== undefined) node.setAttribute('aria-pressed', String(pressed));
  return node;
}
function groupName(id) {
  return labels[id.replace(/^RAK-(?:INT-)?/, '')] || id;
}
function componentName(entry) {
  return entry.nama || entry.name || entry.id;
}
function componentGroup(entry) {
  return entry.parent?.startsWith('RAK-') ? entry.parent
    : entry.rakitan || entry.assembly || 'Komponen';
}
function setPanel(title, render) {
  $('panel-title').textContent = title;
  panelBody.replaceChildren();
  render(panelBody);
  panel.hidden = false;
  $('parts').setAttribute('aria-expanded', String(state.mode === 'parts'));
}
function closePanel() {
  panel.hidden = true;
  $('parts').setAttribute('aria-expanded','false');
}
function sourceLinks(parent, refs = []) {
  if (!Array.isArray(refs)) refs = [refs];
  const list = element('ul', undefined, 'registry');
  for (const ref of refs) {
    if (!ref) continue;
    const line = typeof ref === 'string' ? ref : ref.locator || ref.id || JSON.stringify(ref);
    const item = element('li', line);
    const source = data.sources.find(({id}) => line.startsWith(id) || line.includes(' '+id));
    if (source?.url) {
      const link = element('a', 'Buka sumber');
      link.href = source.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      item.append(document.createTextNode(' · '), link);
    }
    list.append(item);
  }
  if (list.children.length) parent.append(list);
}
function showParts() {
  setPanel('Komponen', (body) => {
    const byGroup = new Map();
    for (const entry of entries.values()) {
      const group = componentGroup(entry);
      if (!byGroup.has(group)) byGroup.set(group, []);
      byGroup.get(group).push(entry);
    }
    for (const [key, parts] of byGroup) {
      const section = element('details');
      section.open = parts.some(({id}) => id === state.selected);
      section.append(element('summary', groupName(key) + ' · ' + parts.length));
      const list = element('div', undefined, 'group-items');
      for (const entry of parts) {
        list.append(button(componentName(entry), () => select(entry.id), entry.id === state.selected));
      }
      section.append(list);
      body.append(section);
    }
    if (!entries.size) body.append(element('p', 'Inventaris model belum tersedia.'));
  });
}
function renderComponent(entry) {
  setPanel(componentName(entry), (body) => {
    body.append(element('span', (entry.status || 'UNVERIFIED').toString() + ' · ' + entry.id, 'status'));
    const notes = entry.notes || entry.catatan || entry.note;
    if (notes) for (const note of [].concat(notes)) body.append(element('p', typeof note === 'string' ? note : JSON.stringify(note)));
    const partNumbers = [].concat(entry.part_number || []).filter(Boolean);
    if (partNumbers.length) body.append(element('p', 'Nomor katalog ' + partNumbers.join(', ')));
    body.append(element('small','Jumlah pada model '+(entry.quantity || entry.count || entry.jumlah || 1)));
    sourceLinks(body, entry.source_refs || entry.sumber);
    const actions = element('div', undefined, 'actions');
    actions.append(button('Daftar komponen', () => changeMode('parts')));
    if (entry.object) actions.append(button(state.isolated ? 'Tampilkan semua' : 'Isolasi', () => {
      state.isolated = !state.isolated;
      applyPose();
      frame();
      renderComponent(entry);
    }, state.isolated));
    const parts = assemblyRows(componentGroup(entry), entry);
    if (entry.object && parts.length > 1) actions.append(button('Eksplor rakitan', () => openDiagram(entry)));
    body.append(actions);
  });
}
function select(id) {
  if (state.mode === 'assembly') {
    state.selected = id;
    refreshHighlight();
    for (const [key, control] of state.assemblyControls) control.setAttribute('aria-pressed', String(key === id));
    const entry = entries.get(id);
    const detail = $('assembly-detail');
    detail.replaceChildren(element('h3', componentName(entry)), element('p', (entry.status || 'UNVERIFIED')+' · '+entry.id));
    sourceLinks(detail, entry.source_refs || entry.sumber);
    return;
  }
  const entry = entries.get(id);
  if (!entry) return;
  state.isolated = state.isolated && state.selected === id;
  state.selected = id;
  changeMode('component');
}
function assemblyRows(group, anchor) {
  const scopedCylinder = ['RAK-INT-PISTON','RAK-INT-ROD','RAK-INT-LINER','RAK-INT-VALVE','RAK-INT-FUELINJ'].includes(group);
  const cylinder = (entry) => {
    const parsedParent = entry.parent?.match(/^MOT-INT-[A-Z]+-(\d)(?:-|$)/)?.[1];
    if (parsedParent) return Number(parsedParent);
    const center = new T.Box3().setFromObject(entry.object).getCenter(new T.Vector3());
    return Math.max(1,Math.min(6,Math.round((center.x-.209)/.2)+1));
  };
  const localCylinder = scopedCylinder && anchor?.object ? cylinder(anchor) : null;
  return Array.from(entries.values()).filter(entry => componentGroup(entry) === group && entry.object
    && (!localCylinder || cylinder(entry) === localCylinder));
}
function openDiagram(entry) {
  const id = componentGroup(entry);
  const group = groups.get(id)?.object;
  if (!group) return;
  previousView = {
    mode:state.mode, selected:state.selected, isolated:state.isolated,
    position:camera.position.clone(), target:controls.target.clone()
  };
  state.mode = 'assembly';
  state.running = false;
  state.assemblyGroup = id;
  state.assemblyControls = new Map();
  const components = assemblyRows(id, entry);
  state.assemblyParts = new Set(components.map(part=>part.id));
  applyPose();
  setPanel('Eksplor rakitan', body => {
    body.append(button('Kembali', restoreDiagram));
    const detail = element('section', undefined, 'details');
    detail.id = 'assembly-detail';
    body.append(detail);
  });
  const boxes = components.map(({object}) => new T.Box3().setFromObject(object));
  const order = components.map((part, index) => ({part,index,center:boxes[index].getCenter(new T.Vector3())}));
  const vector = new T.Vector3(...(spreadVectors[id.replace(/^RAK-(?:INT-)?/,'')] || [1,0,0]));
  const direction = vector.lengthSq() ? vector.normalize() : new T.Vector3(1,0,0);
  const authored = data.assemblies[id] || {};
  order.sort((a,b) => a.center.dot(direction)-b.center.dot(direction));
  const offsets = new Map(order.map(({part}, index) => {
    const item = authored.parts?.find(row => row.id === part.id || row.component_id === part.id);
    const offset = item?.offset_m || item?.explode_vector_m || item?.explode_m;
    const magnitude = Math.min(.065, .4 / components.length);
    return [part.id, Array.isArray(offset) ? new T.Vector3(...offset) :
      direction.clone().multiplyScalar((index-(order.length-1)/2)*magnitude)];
  }));
  const meshes = [];
  const rows = [];
  const trows = [];
  for (const part of components) {
    const key = part.id;
    const number = Array.isArray(part.part_number) ? part.part_number.join(', ') : part.part_number;
    // Catalog numbers may repeat across physically distinct meshes.
    rows.push([key, componentName(part), part.quantity || part.count || part.jumlah || 1, number]);
    const control = button(componentName(part), () => select(key), state.selected === key);
    state.assemblyControls.set(key, control);
    trows.push(control);
    part.object.traverse(mesh => {
      if (!mesh.isMesh || mesh.userData.component !== key) return;
      const inverseRotation = mesh.parent.getWorldQuaternion(new T.Quaternion()).invert();
      mesh.userData.no = key;
      mesh.userData.ws = mesh.position.clone();
      mesh.userData.ev = offsets.get(key).clone().applyQuaternion(inverseRotation);
      meshes.push(mesh);
    });
  }
  const part = {group,rows,meshes,trows,idn:groupName(id)};
  const model = {camera, axis:'x', cfg:{nosLabel:'No. katalog'}, rowStatus:(_part,row) => ({
    jumlah:'ilustrasi', nomor:row[3] ? 'katalog' : 'model', identifier:row[3]
  })};
  stopDiagram = window.openAssemblyDiagram(model, part, stage, panelBody);
  select(entry.id);
  if (authored.view?.some(Boolean)) {
    const view = new T.Vector3(...authored.view).normalize();
    if (Math.abs(view.y) > .95) view.x = .24;
    camera.position.copy(controls.target).add(view);
  }
  requestAnimationFrame(() => frame());
  updateNav();
}
function leaveDiagram() {
  if (!stopDiagram) return;
  stopDiagram();
  stopDiagram = null;
  state.assemblyControls = null;
  state.assemblyGroup = null;
  state.assemblyParts = null;
}
function restoreDiagram() {
  const view = previousView;
  leaveDiagram();
  previousView = null;
  if (!view) return;
  state.selected = view.selected;
  state.isolated = view.isolated;
  changeMode(view.mode);
  camera.position.copy(view.position);
  controls.target.copy(view.target);
  controls.update();
}
function showSystems() {
  setPanel('Sistem', body => {
    const tabs = element('div', undefined, 'tabs');
    tabs.setAttribute('aria-label','Pilih sistem');
    for (const graph of data.systems) tabs.append(button(systemLabels[graph.system] || graph.system,
      () => { state.system = graph.system; showSystems(); }, state.system === graph.system));
    body.append(tabs);
    const graph = data.systems.find(({system}) => system === state.system);
    if (!graph) { body.append(element('p', 'Data sistem belum tersedia.')); return; }
    body.append(element('span', graph.status, 'status'), element('p', graph.applicability));
    const names = new Map(graph.nodes.map(node => [node.id, node.name || node.label || node.id]));
    const list = element('ol', undefined, 'system-edges');
    for (const edge of graph.edges) {
      const item = element('li');
      const known = ['DOCUMENTED','OBSERVED','INFERRED'].includes(edge.status);
      const separator = known ? ' → ' : ' · ';
