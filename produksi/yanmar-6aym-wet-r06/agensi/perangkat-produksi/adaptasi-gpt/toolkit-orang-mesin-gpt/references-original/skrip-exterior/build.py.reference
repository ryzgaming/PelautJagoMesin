# ---- Heat exchanger shell-and-tube, dipecah per bagian (Eksplor Rangkaian) ----
# Sumbu shell = X (tutup depan ber-pelat X di P23 menghadap +X); bundel ditarik ke +X.
ASM["EXT-HX"] = dict(id="EXT-HX", nama="Heat exchanger shell-and-tube depan (jacket water / aftercooler, didinginkan air laut)", node_rakitan="RAK-HX",
                     acuan=dict(no=1, object_ids=["EXT-HX-SHELL-1"]), diagram=dict(arah_pandang=[-0.35, -0.40, -0.85], atas=[0, 1, 0]), bagian={})
SRC_HX = "P22, P23, P25 (marine: inti bertabung bersirip terlihat di sisi, pelat X di muka depan, selang hitam); D03 hlm. 1 (engine-mounted SW pump and heat exchanger); " + SRC_D01F
X0, X1 = 2.150, 2.350            # muka flens shell belakang / depan
FY0, FY1, FZ = 0.545, 0.935, 0.55  # batas flens (dimensi luar lama dipertahankan)
BY0, BY1, BZ = 0.575, 0.905, 0.50  # badan shell
IY0, IY1, IZ = 0.585, 0.895, 0.49  # lubang dalam
def rect_ring(p, x0, x1, y0, y1, z, iy0, iy1, iz, m=None, bev=0.0):
    t = x1 - x0; xc = (x0 + x1) / 2
    p.box((xc, (y1 + iy1) / 2, 0), (t, y1 - iy1, 2 * z), bev=bev, m=m)
    p.box((xc, (y0 + iy0) / 2, 0), (t, iy0 - y0, 2 * z), bev=bev, m=m)
    for sg in (1, -1):
        p.box((xc, (iy0 + iy1) / 2, sg * (z + iz) / 2), (t, iy1 - iy0, z - iz), bev=bev, m=m)
# 1 shell (acuan)
asm_part("EXT-HX", 1, "Rumah / shell heat exchanger (acuan, tidak bergerak)", "OBSERVED", SRC_HX, "menampung bundel tabung dan aliran air pendingin mesin di sisi shell; dudukan ke mesin")
sh_ = Part("EXT-HX-SHELL-1", "Rumah / shell heat exchanger (acuan)", "HX", YEL, "OBSERVED", SRC_HX,
           "keberadaan OBSERVED; dimensi luar dipertahankan dari model sebelumnya (ESTIMATED, datum.front_tank_heat_exchanger); jendela samping meniru inti bersirip yang terlihat di P22/P25; tebal dinding ILLUSTRATIVE")
sh_.box((2.25, BY1 - 0.005, 0), (X1 - X0, 0.01, 2 * BZ))
sh_.box((2.25, BY0 + 0.005, 0), (X1 - X0, 0.01, 2 * BZ))
for sg in (1, -1):                                   # dinding samping berjendela (bingkai)
    zz = sg * (BZ - 0.005)
    sh_.box((2.25, BY1 - 0.03, zz), (X1 - X0, 0.05, 0.012), bev=0.003)
    sh_.box((2.25, BY0 + 0.03, zz), (X1 - X0, 0.05, 0.012), bev=0.003)
    sh_.box((X0 + 0.03, 0.74, zz), (0.05, BY1 - BY0, 0.012), bev=0.003)
    sh_.box((X1 - 0.03, 0.74, zz), (0.05, BY1 - BY0, 0.012), bev=0.003)
    sh_.box((2.25, 0.74, zz), (0.02, BY1 - BY0, 0.012), bev=0.003)
for xf in (X0, X1 - 0.012):                          # flens ujung
    rect_ring(sh_, xf, xf + 0.012, FY0, FY1, FZ, IY0, IY1, IZ, bev=0.002)
for (zz, xx) in ((0.427, 2.23), (-0.44, 2.22)):      # nosel bawah ke pipa air
    sh_.cyl((xx, BY0 - 0.012, zz), (0, -1, 0), 0.075, 0.024, n=24, bev=0.003)
sh_.box((2.25, BY0 - 0.006, 0.0), (0.12, 0.012, 0.20), bev=0.003)   # dudukan bawah
sh_.finish()
# 4 bundel tabung
asm_part("EXT-HX", 4, "Bundel tabung (tube bundle): tube sheet depan dan belakang, tabung, baffle/support plate", "ILLUSTRATIVE",
         "P22, P25 (tabung bersirip terlihat di sisi; jumlah dan susunan tabung tidak terbaca)", "memisahkan air laut di dalam tabung dari air pendingin mesin di sisi shell; panas berpindah lewat dinding tabung")
bd = Part("EXT-HX-BUNDLE-1", "Bundel tabung (tube sheet, tabung, baffle)", "HX", STL, "ILLUSTRATIVE",
          "P22, P25 (inti bertabung terlihat)", "jumlah tabung (12 x 38), diameter 12 mm, 6 baffle segmental, tube sheet belakang mengambang: semuanya ILLUSTRATIVE")
RS0, RS1 = 2.170, 2.180
FS0, FS1 = 2.353, 2.365
bd.box(((RS0 + RS1) / 2, 0.74, 0), (RS1 - RS0, IY1 - IY0 - 0.01, 2 * IZ - 0.01), m=YEL)            # tube sheet belakang (mengambang)
bd.box(((FS0 + FS1) / 2, 0.74, 0), (FS1 - FS0, FY1 - FY0, 2 * FZ), m=YEL, bev=0.002)            # tube sheet depan (terjepit)
for iy in range(12):
    for iz in range(38):
        yy = 0.605 + iy * 0.025; zz = -0.4625 + iz * 0.025
        bd.cyl(((RS0 + FS1) / 2 - 0.002, yy, zz), (1, 0, 0), 0.0062, FS0 - RS0 + 0.004, n=6, m=STL)
for k, xb in enumerate((2.205, 2.230, 2.255, 2.280, 2.305, 2.330)):   # baffle segmental bergantian
    h_ = (IY1 - IY0 - 0.01) * 0.75
    yc = (IY0 + 0.005 + h_ / 2) if k % 2 == 0 else (IY1 - 0.005 - h_ / 2)
    bd.box((xb, yc, 0), (0.004, h_, 2 * IZ - 0.01), m=YEL)
for zz in (-0.40, 0.40):                                                 # tie rod
    bd.cyl(((RS1 + FS0) / 2, 0.74, zz), (1, 0, 0), 0.008, FS0 - RS1, n=10, m=YEL)
bd.finish()
asm_pos("EXT-HX", 4, "EXT-HX-BUNDLE-1", (1, 0, 0), 0.22, 4)
# 2 tutup depan, 3 tutup belakang
asm_part("EXT-HX", 2, "Tutup ujung depan (front end cover / bonnet) dengan flens", "OBSERVED", "P23 (muka depan dengan pelat X dan baut tepi); P22",
         "menutup ruang air laut depan dan mengarahkan aliran balik tabung; dibuka untuk menarik bundel")
fcv = Part("EXT-HX-TUTUPDEPAN-1", "Tutup ujung depan heat exchanger", "HX", YEL, "OBSERVED", "P23, P22",
           "bentuk pelat datar dengan panel terangkat ESTIMATED dari P23; tebal ILLUSTRATIVE")
fcv.box((2.374, 0.74, 0), (0.012, FY1 - FY0, 2 * FZ), bev=0.003)
fcv.box((2.383, 0.74, 0), (0.006, 0.28, 0.88), bev=0.004)
fcv.finish()
asm_pos("EXT-HX", 2, "EXT-HX-TUTUPDEPAN-1", (1, 0, 0), 0.33, 6)
asm_part("EXT-HX", 3, "Tutup ujung belakang (rear end cover / bonnet) dengan flens", "ILLUSTRATIVE", "P22 (ujung belakang gelap di sisi HE); bentuk bonnet tidak terlihat jelas",
         "menutup ruang air laut belakang (masuk/keluar air laut); menahan anoda seng")
rcv = Part("EXT-HX-TUTUPBELAKANG-1", "Tutup ujung belakang heat exchanger (bonnet)", "HX", YEL, "ILLUSTRATIVE", "P22", "bentuk bonnet ILLUSTRATIVE")
rcv.box((2.141, 0.74, 0), (0.012, FY1 - FY0, 2 * FZ), bev=0.003)
