        p.box((min(max(x - (0 if s > 0 else BANK_OFF), 0.016), 1.867), -0.01, s * 0.482), (0.032, 0.50, 0.026), bev=0.006)
    p.box((0.94, 0.225, s * 0.484), (1.88, 0.06, 0.03), bev=0.008)        # boss memanjang (camshaft)
    p.box((0.94, -0.245, s * 0.48), (1.88, 0.035, 0.022), bev=0.006)      # bibir bawah
