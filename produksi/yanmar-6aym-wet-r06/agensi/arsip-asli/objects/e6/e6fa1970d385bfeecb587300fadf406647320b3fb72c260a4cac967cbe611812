import assert from 'node:assert/strict';
import {readFile} from 'node:fs/promises';
import vm from 'node:vm';

const assets = new URL('../assets/',import.meta.url);
const file = async path => readFile(new URL(path,assets));
const entries = new Map();
const offline = process.argv.includes('--offline');
const missingModel = process.argv.includes('--missing-model');
const noWebGL = process.argv.includes('--no-webgl');
const managedFrames = new Map();
const resizeObservers = [];
class Node {
  constructor(name) {
    this.tagName = name;
    this.children = [];
    this.attributes = {};
    this.handlers = {};
    this.classList = { toggle() {} };
    this.style = {};
    this.clientWidth = 1050;
    this.clientHeight = 650;
  }
  set id(value) { entries.set(value,this); }
  addEventListener(name,handler) { this.handlers[name]=handler; }
  dispatch(name) { this.handlers[name]?.({}); }
  click() { if (!this.disabled) this.dispatch('click'); }
  setAttribute(key,value) { this.attributes[key]=value; }
  getAttribute(key) { return this.attributes[key]; }
  append(...items) { this.children.push(...items); for (const item of items) item.parent=this; }
  prepend(...items) { this.children.unshift(...items); for (const item of items) item.parent=this; }
  replaceChildren(...items) { this.children=[]; this.append(...items); }
  remove() { this.parent.children=this.parent.children.filter(child=>child!==this); }
}
for (const id of ['stage','panel','panel-body','panel-title','parts','xray','spread','spread-value',
  'spread-box','canvas','loading','reset','close','sources','review-status']) new Node(id).id=id;
entries.get('spread').value='50';
const modes = ['overview','systems','operation'].map(mode=>{
  const button = new Node('button');
  button.dataset={mode};
  button.setAttribute("aria-pressed","false");
  return button;
});
const document = {
  getElementById:id=>entries.get(id),
  createElement:tag=>new Node(tag),
  createTextNode:text=>Object.assign(new Node('#text'),{textContent:text}),
  createElementNS:(_,tag)=>new Node(tag),
  querySelectorAll:()=>modes,
  body:new Node('body')
};
let nextFrame=0;
const sandbox=vm.createContext({
  console,TextDecoder,Blob,URL,document,atob,
  fetch:async ()=>{
    assert.equal(offline,false,'Standalone requested a remote asset');
    return {ok:true,json:async()=>JSON.parse(await file('data.json'))};
  },
  ResizeObserver:class { constructor(handler){resizeObservers.push(handler)} observe(){} },
  requestAnimationFrame:(handler)=>{managedFrames.set(++nextFrame,handler); return nextFrame},
  cancelAnimationFrame:(id)=>managedFrames.delete(id),
  addEventListener(){}
});
sandbox.window=sandbox;
const run=body=>vm.runInContext(body,sandbox);
let scripts;
if (offline) {
  const html = await readFile(new URL('../yanmar-6aym-wet-gpt-draft.html',import.meta.url),'utf8');
  assert.ok(html.includes('DRAF — QA BELUM LENGKAP'));
  assert.ok(!/<(?:script|link)[^>]+(?:src|href)="assets\//.test(html));
  for (const [,id,contents] of html.matchAll(/<script type="[^"]+" id="(embedded-[^"]+)">([\s\S]*?)<\/script>/g)) {
    const element = new Node('script');
    element.id=id;
    element.textContent=contents;
  }
  scripts=Array.from(html.matchAll(/<script>\s*([\s\S]*?)<\/script>/g),match=>match[1]);
} else scripts=await Promise.all(['three-bundle.js','assembly-diagram.js','studio.js'].map(path=>file(path).then(raw=>raw.toString())));
assert.equal(scripts.length,3);
run(scripts[0]);
const T=sandbox.THREE;
const parse=T.GLTFLoader.prototype.parse;
T.GLTFLoader.prototype.loadAsync=async function (path) {
  assert.equal(offline,false,'Standalone requested a GLB URL');
  if (missingModel && path.endsWith('internal.glb')) throw new Error('Simulated GLB failure');
  const raw=await file(path.split('/').at(-1));
  const bytes=raw.buffer.slice(raw.byteOffset,raw.byteOffset+raw.byteLength);
  return new Promise((resolve,reject)=>parse.call(this,bytes,'',resolve,reject));
};
T.WebGLRenderer=class {
  constructor(){
    if (noWebGL) throw new Error('Simulated WebGL failure');
    this.domElement=new Node('canvas');
  }
  setPixelRatio(){}
  setSize(){}
  setAnimationLoop(loop){this.loop=loop}
  render(){}
};
T.OrbitControls=class {
  constructor(){this.target=new T.Vector3()}
  update(){}
};
run(scripts[1]);
await run(scripts[2].replace(/start\(\);\s*$/,'start()'));
if (missingModel || noWebGL) {
  assert.ok(entries.get('loading').textContent.includes(missingModel?'Sebagian aset':'Simulated WebGL'));
  entries.get('parts').click();
  assert.equal(entries.get('panel-title').textContent,'Komponen');
  assert.ok(entries.get('panel-body').children.length > 0);
  modes[1].click();
  assert.equal(entries.get('panel-body').children[0].children.length,5);
  console.log('PASS: Inventory and systems remain accessible during simulated '+(missingModel?'GLB loading':'WebGL setup')+' failure.');
  process.exit(0);
}
assert.equal(run('roots.every(Boolean)'),true);
assert.equal(entries.get('loading').hidden,true);
assert.equal(run('state.mode'),'home');
assert.equal(modes[0].getAttribute('aria-pressed'),'false');
assert.equal(run("groups.get('RAK-FLYWHEEL').object.position.x"),0);
function drawFrames() {
  const frames = Array.from(managedFrames);
  managedFrames.clear();
  for (const [,frame] of frames) frame();
}
for (const [width,height] of [[1050,650],[390,780],[780,390]]) {
  const host = entries.get('canvas');
  host.clientWidth=width;
  host.clientHeight=height;
  for (const resize of resizeObservers) resize();
  drawFrames();
  assert.equal(run('camera.aspect'),width/height);
  assert.ok(run('camera.position.length()')>0);
}
modes[0].click();
assert.equal(entries.get('spread-box').hidden,false);
assert.equal(run("groups.get('RAK-FLYWHEEL').object.position.x"),-.215);
entries.get('spread').value='100';
entries.get('spread').dispatch('input');
assert.equal(run("groups.get('RAK-FLYWHEEL').object.position.x"),-.43);
entries.get('xray').click();
assert.equal(run('state.xray'),true);
assert.equal(run('[...shellMaterials.values()].every(({transparent})=>transparent.transparent)'),true);
modes[1].click();
assert.equal(run("groups.get('RAK-FLYWHEEL').object.position.x"),0);
assert.equal(run('state.xray'),true);
assert.equal(entries.get('panel-body').children[0].children.length,5);
modes[2].click();
assert.equal(run('Boolean(kinematicParts())'),true);
entries.get('panel-body').children[1].click();
