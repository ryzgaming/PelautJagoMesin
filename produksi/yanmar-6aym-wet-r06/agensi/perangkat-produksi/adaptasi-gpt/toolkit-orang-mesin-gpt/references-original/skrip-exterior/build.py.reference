# ================= RAKITAN: KEPALA SILINDER + TUTUP KATUP =================
for s, tag in ((1, "R"), (-1, "L")):
    R = bankR(s)
    for i, x in enumerate(CYLX):
        cx = x - (0 if s > 0 else BANK_OFF)
        no = (2 * i + 1) if s > 0 else (2 * i + 2)
        u, n = bank(s)
        h = Part(f"EXT-KEPALA-{tag}{i+1}", f"Kepala silinder (cylinder head) individual silinder {no}", "KEPALA", YEL, "ESTIMATED" if s > 0 else "ILLUSTRATIVE",
                 SRC_D01S + " (pita kepala+tutup y 0.55..0.87); datum.cylinder_heads", "kepala individual per silinder INFERRED; tinggi 0.16 m dan lebar 0.30 m ESTIMATED; bentuk rinci (tepi miring, 4 boss baut, rusuk, flens port exhaust, boss jumper air) ILLUSTRATIVE (QA-06)" + ("; posisi X: " + LNOTE if s < 0 else ""))
        h.box(BP(s, cx, 0.645, 0.0), (0.250, 0.05, 0.30), R=R, bev=0.008)                 # flens dasar ke deck
        h.box(BP(s, cx, 0.715, 0.0), (0.236, 0.10, 0.282), R=R, bev=0.03, seg=1)          # badan bertepi miring
        h.box(BP(s, cx, 0.770, 0.0), (0.250, 0.022, 0.30), R=R, bev=0.006)               # bibir atas
        for bx in (-0.112, 0.112):                                                          # boss baut kepala tegak di 4 sudut
            for ba in (-0.135, 0.135):
                h.cyl(BP(s, cx + bx, 0.705, ba), u, 0.021, 0.13, n=12, bev=0.004)
        for bx in (-0.06, 0.06):
            h.box(BP(s, cx + bx, 0.705, 0.146), (0.018, 0.10, 0.016), R=R, bev=0.004)
        h.box(BP(s, cx, 0.715, 0.147), (0.07, 0.05, 0.012), R=R, bev=0.004)            # tutup lubang coran / water jacket plug
        h.cyl(BP(s, cx, 0.715, 0.153), n, 0.012, 0.012, n=6, m=STL)
        h.cyl(BP(s, cx, 0.70, -0.146), -n, 0.062, 0.012, n=20, bev=0.003)             # flens port exhaust (muka dalam)
        h.cyl(BP(s, cx + 0.115, 0.735, 0.0), V((1, 0, 0)), 0.03, 0.02, n=14, bev=0.004) # boss jumper air antar kepala
        for bx in (-0.105, 0.105):
            for ba in (-0.135, 0.135):
                h.bolt(BP(s, cx + bx, 0.78, ba), u, r=0.013, h=0.02)
        h.finish()
        c = Part(f"EXT-TUTUPKATUP-{tag}{i+1}", f"Tutup katup (valve cover) silinder {no}", "KEPALA", YEL, "OBSERVED" if s > 0 else "ILLUSTRATIVE",
                 "P12, P19 (tutup per silinder bertepi miring); D02 hlm. 1 render; " + SRC_D01S + ("; P26, P11 (bank kiri, genset)" if s < 0 else ""),
                 "pusat x dari datum.block.cylinders; panjang kubah 0.186 m (datum.cylinder_heads.valve_cover_length_x) ESTIMATED" + ("; bentuk OBSERVED (P26); posisi X: " + LNOTE if s < 0 else ""))
        ac = 0.035
        c.box(BP(s, cx, 0.792, ac), (0.226, 0.026, 0.205), R=R, bev=0.006)
        c.box(BP(s, cx, 0.862, ac), (0.186, 0.12, 0.175), R=R, bev=0.038, seg=1)   # kubah bertepi miring
        c.box(BP(s, cx, 0.925, ac), (0.12, 0.02, 0.11), R=R, bev=0.012, seg=1)
        for bx in (-0.068, 0.068):
            for ba in (-0.055, 0.055):
                c.bolt(BP(s, cx + bx, 0.91, ac + ba), u, r=0.010, h=0.03)
        c.cyl(BP(s, cx - 0.06, 0.83, ac + 0.09), n, 0.018, 0.02, n=12)               # boss konektor
        c.finish()

# ================= RAKITAN: EXHAUST (manifold kering di lembah V) =================
for s, tag in ((1, "R"), (-1, "L")):
    e = Part(f"EXT-EXHMAN-{tag}", f"Exhaust manifold kering modular bank {'kanan' if s>0 else 'kiri'} dengan runner per silinder",
             "EXHAUST", TRB, "INFERRED" if s > 0 else "ILLUSTRATIVE",
             "D03 hlm. 1 (dry, gas-tight, modular pulse, SOLAS shield, satu outlet); datum.exhaust_manifold; letak di lembah V INFERRED",
             "rute runner, diameter (0.13 m pipa utama) dan sambungan slip ILLUSTRATIVE; manifold tersembunyi di bawah aftercooler" + ("; runner dan sambungan slip: " + LNOTE if s < 0 else ""))
    zm, ym = s * 0.105, 0.82
    e.sweep([V((1.66, ym, zm)), V((0.10, ym, zm))], 0.062, n=20)
    e.cyl((1.68, ym, zm), (1, 0, 0), 0.066, 0.04, n=20, bev=0.005)
    for x in [cx + 0.135 - (0 if s > 0 else BANK_OFF) for cx in CYLX[1:]]:
        e.cyl((x, ym, zm), (1, 0, 0), 0.072, 0.035, n=20, bev=0.004)            # sambungan slip/bellows
    for x in CYLX:
        cx = x - (0 if s > 0 else BANK_OFF)
        s0 = BP(s, cx, 0.70, -0.158)
        _, n_ = bank(s)
        path = [s0, s0 - n_ * 0.05, V((cx, 0.78, s * 0.15)), V((cx, ym, zm))]
        e.sweep(fillet(path, 0.04, 6), 0.036, n=14)
        e.cyl(s0 - n_ * 0.006, -n_, 0.055, 0.014, n=14)
        e.bolt_circle(s0 - n_ * 0.013, -n_, 0.046, 4, r=0.008, h=0.008)
    # ke turbin: belakang lalu naik ke inlet tangensial di atas rumah turbin
    tz = s * 0.38
    path = fillet([V((0.12, ym, zm)), V((-0.02, ym, zm)), V((-0.10, 0.95, s * 0.30)), V((-0.10, 1.0, tz)), V((-0.17, 1.0, tz))], 0.07, 8)
    e.sweep(path, 0.062, n=20)
    e.finish()

# ================= RAKITAN: TURBO =================
def volute(p, c, e1, e2, axis, R0, R1, r0, r1, th0, th1, m, n=18, steps=56):
    c = V(c); e1 = V(e1); e2 = V(e2)
    pts, rr = [], []
    for k in range(steps + 1):
        t = k / steps; th = th0 + (th1 - th0) * t
        Rr = R0 + (R1 - R0) * t
        pts.append(c + Rr * (math.cos(th) * e1 + math.sin(th) * e2)); rr.append(r0 + (r1 - r0) * t)
    P, T = p.sweep(pts, rr, n=n, m=m)
    return P[-1], T[-1], rr[-1]

TX, TY = -0.28, 0.833
SRC_TRB = "D02 hlm. 1 dan D03 hlm. 1 (dual turbochargers; D01 hlm. 2 water-cooled bearings); posisi datum.turbochargers.approx_center (-0.28, 0.833) INFERRED; P14 (genset, belakang)"
def wheel(p, c, ax, r_hub0, r_hub1, r_tip, z0, z1, nbl, back=None, m=None):
    ax = V(ax); c = V(c)
    p.lathe([(0.0001, z0), (r_hub0, z0), (r_hub1, z1), (0.0001, z1)], c, ax, n=32, m=m)
    if back: p.cyl(c + ax * (z0 + 0.003), ax, back, 0.006, n=40, m=m)
    R_ = frame(ax)
    for k in range(nbl):
        a_ = 2 * math.pi * k / nbl
        rad = R_ @ V((math.cos(a_), math.sin(a_), 0)); tan = ax.cross(rad)
        rm = (r_hub0 + r_tip) / 2
        Rb = Matrix((tan, ax, rad)).transposed() @ Matrix.Rotation(math.radians(25), 3, "Z")
        p.box(c + ax * ((z0 + z1) / 2) + rad * rm, (0.004, (z1 - z0) * 0.9, r_tip - r_hub0), R=Rb, m=m)
for s, tag in ((1, "R"), (-1, "L")):
    if s > 0:
        ASM["EXT-TRB-R"] = dict(id="EXT-TRB-R", nama="Turbocharger bank kanan", node_rakitan="RAK-TRB-R",
                                acuan=dict(no=2, object_ids=["EXT-TRB-R-CHRA-1"]), diagram=dict(arah_pandang=[0.80, -0.45, -0.40], atas=[0, 1, 0]), bagian={})
        NT = "turbo kanan dipecah untuk Eksplor Rangkaian; diameter rumah keong UNKNOWN (tertutup di gambar resmi) -> ukuran ILLUSTRATIVE; poros turbo sejajar Z"
        tc = Part("EXT-TRB-R-KOMPRESOR-1", "Rumah kompresor (keong) turbo kanan dengan nosel inlet dan flens", "TRB-R", TRB, "INFERRED", SRC_TRB, NT)
        tch = Part("EXT-TRB-R-CHRA-1", "Center housing / bearing housing turbo kanan (berpendingin air, acuan)", "TRB-R", TRB, "INFERRED", SRC_TRB + "; D01 hlm. 2 (water-cooled bearings)", NT)
        tt = Part("EXT-TRB-R-TURBIN-1", "Rumah turbin (keong) turbo kanan dengan stub inlet berflens dan outlet aksial", "TRB-R", TRB, "INFERRED", SRC_TRB, NT)
    else:
        tc = tch = tt = Part(f"EXT-TURBO-{tag}", f"Turbocharger bank {'kanan' if s>0 else 'kiri'} (rumah keong kompresor + turbin, center housing berpendingin air)",
             "TURBO", TRB, "INFERRED", SRC_TRB,
             "diameter rumah keong UNKNOWN (tertutup di gambar resmi) -> ukuran ILLUSTRATIVE; poros turbo sejajar Z")
    t = tc
    ax = V((0, 0, s))
    # kompresor
    zc = s * 0.60
    t.cyl((TX, TY, zc), ax, 0.115, 0.07, n=40, bev=0.01)                         # cakram belakang
    endc, tc_, rc_ = volute(t, (TX, TY, zc), (1, 0, 0), (0, 1, 0), ax, 0.105, 0.150, 0.03, 0.062, math.pi * 0.05 - 2 * math.pi * 0.95, math.pi * 0.0, TRB)
    t.lathe([(0.085, 0.0), (0.095, 0.05), (0.10, 0.09), (0.125, 0.135), (0.13, 0.145)], (TX, TY, zc), ax, n=40, caps=(False, False))  # nosel inlet
    t.cyl((TX, TY, s * 0.744), ax, 0.135, 0.012, n=40, m=STL)
    t.bolt_circle((TX, TY, s * 0.75), ax, 0.122, 8, r=0.008, h=0.008)
    t.sweep([endc, endc + tc_ * 0.05], rc_, n=18)                                 # stub outlet kompresor
    t.cyl(endc + tc_ * 0.055, tc_, rc_ + 0.025, 0.02, n=18, bev=0.004)
    # center housing (bantalan, berpendingin air)
    t = tch
    t.cyl((TX, TY, s * 0.50), ax, 0.085, 0.09, n=28, bev=0.008)
    t.cyl((TX, TY + 0.09, s * 0.50), (0, 1, 0), 0.016, 0.05, n=10, m=STL)
    t.cyl((TX, TY - 0.09, s * 0.50), (0, 1, 0), 0.016, 0.05, n=10, m=STL)
    # turbin
    t = tt
    zt = s * 0.38
    t.cyl((TX, TY, zt), ax, 0.125, 0.085, n=40, bev=0.01)
    endt, tt_, rt_ = volute(t, (TX, TY, zt), (1, 0, 0), (0, -1, 0), ax, 0.118, 0.165, 0.035, 0.07, math.pi * 0.05 - 2 * math.pi * 0.95 - math.pi / 2, -math.pi / 2, TRB)
    t.sweep([endt, endt + tt_ * 0.06], rt_, n=18)                                 # stub inlet turbin + flens ke manifold
    t.cyl(endt + tt_ * 0.07, tt_, rt_ + 0.03, 0.022, n=18, bev=0.004)
    t.bolt_circle(endt + tt_ * 0.082, tt_, rt_ + 0.018, 6, r=0.008, h=0.008)
    t.lathe([(0.10, 0.0), (0.095, 0.06), (0.085, 0.10)], (TX, TY, s * 0.335), -ax, n=32, caps=(False, True))   # outlet aksial
    if s > 0:
        A = "EXT-TRB-R"
        for p_ in (tc, tch, tt): p_.finish()
        asm_part(A, 1, "Rumah kompresor (compressor housing, keong) dengan nosel inlet dan flens outlet", "INFERRED", SRC_TRB, "mengumpulkan udara bertekanan dari roda kompresor dan mengalirkannya ke aftercooler")
        asm_pos(A, 1, "EXT-TRB-R-KOMPRESOR-1", (0, 0, 1), 0.30, 2)
        asm_part(A, 2, "Center housing / bearing housing (CHRA, acuan, berpendingin air)", "INFERRED", SRC_TRB + "; D01 hlm. 2 (water-cooled bearings)", "menyangga poros rotor pada bantalan berpelumas oli dan didinginkan air")
        asm_part(A, 3, "Rumah turbin (turbine housing, keong) dengan stub inlet berflens dan outlet aksial", "INFERRED", SRC_TRB, "mengarahkan gas buang dari manifold ke roda turbin lalu ke outlet buang")
        asm_pos(A, 3, "EXT-TRB-R-TURBIN-1", (0, 0, -1), 0.25, 2)
        cw = Part("EXT-TRB-R-RODAKOMP-1", "Roda kompresor (compressor wheel) turbo kanan", "TRB-R", STL, "ILLUSTRATIVE", "tidak terlihat di foto atau gambar resmi", "jumlah sudu (12), diameter 0.16 m ILLUSTRATIVE")
        wheel(cw, (TX, TY, 0), (0, 0, 1), 0.03, 0.014, 0.08, 0.565, 0.655, 12, back=0.08)
        cw.cyl((TX, TY, 0.545), (0, 0, 1), 0.008, 0.06, n=10)
        cw.finish()
        asm_part(A, 4, "Roda kompresor (compressor wheel)", "ILLUSTRATIVE", "tidak terlihat; bagian lazim turbocharger", "menghisap dan memampatkan udara masuk; seporos dengan roda turbin")
        asm_pos(A, 4, "EXT-TRB-R-RODAKOMP-1", (0, 0, 1), 0.16, 3)
        tw = Part("EXT-TRB-R-RODATURB-1", "Roda turbin (turbine wheel) turbo kanan", "TRB-R", FLY, "ILLUSTRATIVE", "tidak terlihat di foto atau gambar resmi", "jumlah sudu (11), diameter 0.17 m ILLUSTRATIVE")
        wheel(tw, (TX, TY, 0), (0, 0, -1), 0.032, 0.018, 0.085, -0.425, -0.345, 11, back=0.085)
        tw.cyl((TX, TY, 0.44), (0, 0, 1), 0.01, 0.04, n=10)
        tw.finish()
        asm_part(A, 5, "Roda turbin (turbine wheel) dengan poros", "ILLUSTRATIVE", "tidak terlihat; bagian lazim turbocharger", "diputar gas buang dan memutar roda kompresor lewat poros")
        asm_pos(A, 5, "EXT-TRB-R-RODATURB-1", (0, 0, -1), 0.12, 3)
        asm_part(A, 6, "Clamp V-band", "ILLUSTRATIVE", "tidak terlihat; cara sambungan rumah keong ke center housing ILLUSTRATIVE", "menjepit rumah kompresor dan rumah turbin ke center housing; dibuka pertama saat membongkar")
        for k, (zz, d_, dist) in enumerate(((0.553, 1, 0.20), (0.447, -1, 0.06))):
            vb = Part(f"EXT-TRB-R-VBAND-{k+1}", "Clamp V-band turbo kanan", "TRB-R", STL, "ILLUSTRATIVE", "ILLUSTRATIVE", "r dalam 0.088 m ILLUSTRATIVE")
            vb.lathe([(0.088, zz - 0.009), (0.104, zz - 0.009), (0.106, zz), (0.104, zz + 0.009), (0.088, zz + 0.009), (0.088, zz - 0.009)], (TX, TY, 0), (0, 0, 1), n=40, caps=(False, False))
            vb.box((TX, TY + 0.112, zz), (0.05, 0.016, 0.016), bev=0.003)          # lug T-bolt
            vb.cyl((TX, TY + 0.112, zz), (1, 0, 0), 0.005, 0.07, n=8)
            vb.finish()
            asm_pos(A, 6, f"EXT-TRB-R-VBAND-{k+1}", (0, 0, d_), dist, 1)
    else:
        tt.finish()
    TURBO_END = (endc, tc_, rc_)
    # pipa udara kompresor ke aftercooler (naik lalu maju di atas)
    a = Part(f"EXT-PIPAUDARA-{tag}", f"Pipa udara tekan (compressor discharge) bank {'kanan' if s>0 else 'kiri'} ke aftercooler", "TURBO", YEL, "ESTIMATED",
             SRC_D01S + " (pipa melengkung teratas X 0.08..0.66, Y ~1.39); " + SRC_D02R, "puncak pipa Y 1.417 = datum.overall.y_max (garis ekstensi atas D01, QA-03); rute antara ujung dan diameter 0.13 m ESTIMATED; sambungan ke aftercooler INFERRED")
    st = endc + tc_ * 0.066
    pts = [st, st + tc_ * 0.20, V((st.x + 0.05, 1.24, s * 0.56)), V((0.08, 1.352, s * 0.40)), V((0.42, 1.352, s * 0.22)), V((0.52, 1.24, s * 0.20))]
    pipe(a, pts, 0.065, bend=0.16, flanges=(False, True), m=YEL, nb=8)
    a.cyl(st + tc_ * 0.06, tc_, 0.075, 0.05, n=24, m=RUB)                          # sambungan karet/klem
    a.finish()
    # pelindung panas turbin (heat shield)
    hs = Part(f"EXT-SHIELD-T{tag}", f"Heat shield rumah turbin bank {'kanan' if s>0 else 'kiri'}", "TRB-R" if s > 0 else "TURBO", SHD, "ESTIMATED",
              SRC_D02R + " (penutup abu-abu di atas turbo); D03 hlm. 1 (SOLAS shield)", "bentuk cangkang setengah ILLUSTRATIVE")
    hs.lathe([(0.205, -0.07), (0.215, -0.06), (0.215, 0.06), (0.205, 0.07)], (TX, TY, zt), ax, n=36, a0=math.radians(-10), a1=math.radians(190), closed=False, caps=(False, False))
    hs.lathe([(0.198, -0.07), (0.208, -0.06), (0.208, 0.06), (0.198, 0.07)], (TX, TY, zt), ax, n=36, a0=math.radians(-10), a1=math.radians(190), closed=False, caps=(False, False))
    hs.finish()
    if s > 0:
        asm_part("EXT-TRB-R", 7, "Heat shield rumah turbin (setengah cangkang)", "ESTIMATED", SRC_D02R + " (penutup abu-abu di atas turbo); D03 hlm. 1 (SOLAS shield)", "melindungi awak dan komponen sekitar dari panas rumah turbin")
        asm_pos("EXT-TRB-R", 7, "EXT-SHIELD-TR", (0, 1, 0), 0.25, 1)

# kolektor buang dan outlet tunggal
x_ = Part("EXT-EXHOUT-01", "Kolektor dan outlet gas buang tunggal (flens datar atas)", "EXHAUST", TRB, "ESTIMATED",
          SRC_D01S + " (flens datar X -0.705..-0.534, Y 1.15; datum.exhaust_manifold.exhaust_outlet); D03 hlm. 1 'single exhaust outlet'; P14 (elbow tengah atas)",
          "pipa dari kedua turbin INFERRED; diameter pipa ILLUSTRATIVE")
for s in (1, -1):
    pts = [V((TX, TY, s * 0.28)), V((TX, TY, s * 0.18)), V((-0.50, 0.96, s * 0.10)), V((-0.60, 0.98, s * 0.04))]
    x_.sweep(fillet(pts, 0.08, 8), 0.075, n=20)
x_.lathe([(0.0001, 0.88), (0.10, 0.90), (0.105, 1.02), (0.08, 1.08), (0.065, 1.10), (0.065, 1.13)], (-0.62, 0, 0), (0, 1, 0), n=32)
x_.cyl((-0.62, 1.14, 0), (0, 1, 0), 0.0855, 0.02, n=32, m=STL, bev=0.003)
x_.bolt_circle((-0.62, 1.15, 0), (0, 1, 0), 0.072, 8, r=0.007, h=0.008)
x_.finish()

# ================= RAKITAN: AIR CLEANER =================
for s, tag in ((1, "R"), (-1, "L")):
    zc = s * 0.880
    a = Part(f"EXT-AIRCL-{tag}", f"Air cleaner power core bundar bank {'kanan' if s>0 else 'kiri'} dengan muka berkisi", "AIRCLEANER", YEL, "ESTIMATED",
             SRC_D01S + " (lingkaran O 0.553 m, pusat (-0.28, 0.833)); " + SRC_D01F + "; " + SRC_D02R + "; P22 (marine)",
             "pusat z dipakai simetris +-0.880 (datum: +0.868/-0.909, rata-rata) agar lebar total <= 2.04 m; tebal 0.252 m ESTIMATED (D01 Front elips 75-100 px = 0.23-0.31 m; dipilih agar lebar total sesuai D02 2.037 m +-1%, QA-02); pola kisi ESTIMATED dari render D02")
    ax = V((0, 0, s)); c0 = V((TX, TY, s * 0.745))
    a.lathe([(0.14, 0.0), (0.25, 0.0), (0.272, 0.02), (0.2765, 0.04), (0.2765, 0.217), (0.27, 0.237), (0.258, 0.252), (0.0001, 0.252)], c0, ax, n=48)
    a.sweep([c0 + ax * 0.254 + frame(ax).col[0] * 0.0 + V((0.245 * math.cos(2 * math.pi * k / 64), 0.245 * math.sin(2 * math.pi * k / 64), 0)) for k in range(64)], 0.012, n=8, closed=True)
    a.cyl(c0 + ax * 0.256, ax, 0.232, 0.006, n=48, m=MED)
    for k in range(-4, 5):                                                       # kisi horizontal
        yy = k * 0.05; half = math.sqrt(max(0.0, 0.232 ** 2 - yy ** 2))
        if half < 0.03: continue
        a.box((TX, TY + yy, s * (0.745 + 0.263)), (2 * half, 0.016, 0.012), bev=0.003)
    for xx in (-0.08, 0.08):
        a.box((TX + xx, TY, s * (0.745 + 0.265)), (0.014, 0.44 if xx else 0.46, 0.010), bev=0.003)
    for k in range(12):
        ang = 2 * math.pi * k / 12
        a.bolt(c0 + ax * 0.252 + V((0.262 * math.cos(ang), 0.262 * math.sin(ang), 0)), ax, r=0.010, h=0.01)
    a.cyl((TX, TY + 0.29, s * 0.88), (0, 1, 0), 0.018, 0.04, n=12, m=STL)        # indikator servis
    a.finish()
    b = Part(f"EXT-AIRCLBRK-{tag}", f"Braket pelat trapesium penyangga air cleaner {'kanan' if s>0 else 'kiri'}", "AIRCLEANER", YEL, "ESTIMATED",
             SRC_D01F + " (lebar maksimum di y 0.538, datum.overall.z_widest_at_y); " + SRC_D02R, "identitas elemen UNKNOWN di datum; dibuat sebagai braket penyangga (INFERRED)")
    b.prism([(-0.46, 0.0), (-0.10, 0.0), (-0.16, 0.08), (-0.40, 0.08)], (s * 0.48, s * 1.01), plane="xy", bev=0.006) if False else None
    poly = [(-0.48, 0.0), (-0.08, 0.0), (-0.14, 0.035), (-0.42, 0.035)]
    for q in [poly]:
        pass
    b.box((-0.28, 0.538, s * 0.76), (0.38, 0.03, 0.52), bev=0.006)
    b.box((-0.28, 0.40, s * 0.52), (0.30, 0.27, 0.03), bev=0.006)
    b.box((-0.28, 0.47, s * 0.64), (0.03, 0.15, 0.26), R=Matrix.Rotation(math.radians(-s * 0), 3, "X"), bev=0.004)
    if FIX:   # pelat miring trapesium dari bawah air cleaner ke sisi blok (garis miring D01 Front)
        L = math.hypot(0.38, 0.16); ang = math.atan2(0.16, 0.38)
