import { access, copyFile, mkdir, readFile, readdir, writeFile } from 'node:fs/promises';
const read = async path => JSON.parse(await readFile(new URL(path,import.meta.url),'utf8'));
const base = '../../';
const modelPath = base+'model/';
const list = path => readdir(new URL(path,import.meta.url));
const [documents,photos,videos,datum,exterior,internal,kinematics] = await Promise.all([
  read(base+'doc/sources.json'),read(base+'foto/evidence-foto.json'),read(base+'video/evidence-video.json'),
  read(modelPath+'datum.json'),read(modelPath+'exterior/inventory.json'),
  read(modelPath+'internal/inventory.json'),read(modelPath+'internal/kinematics.json')
]);
const sources = [...documents.sources,...(photos.sources || []),...(videos.videos || [])]
  .map(source=>({
    id:source.id,
    url:source.page_url || source.url || source.source_url,
    title:source.title || source.publisher || source.variant || source.id,
    status:source.evidence_status || source.status
  })).filter(entry=>entry.id && /^https:\/\//i.test(entry.url));
for (const source of documents.sources) for (const item of source.locators || []) {
  if (!item.figure || !/^https:\/\//i.test(item.url)) continue;
  sources.unshift({id:source.id+'-'+item.figure, url:item.url,
    title:source.title+' · Fig. '+item.figure, status:source.evidence_status});
}
const supplemental = await read(base+'qa/coverage/assembly-coverage.json').catch(error=>{
  if (error.code !== 'ENOENT') throw error;
  return {};
});
const coverage = Object.fromEntries(['by_assembly','by_object'].map(key=>[key,Object.fromEntries(
  Object.entries(supplemental[key] || {}).map(([id,item])=>[id,Object.fromEntries(
    ['summary','open','status','source_refs'].filter(name=>name in item).map(name=>[name,item[name]])
  )])
)]));
if (!sources.some(source=>source.id==='D05-37')) sources.unshift({
  id:'D05-37', title:'6AYM-WET · Katalog komponen Fig. 37 Air cooler',status:'DOCUMENTED',
  url:'https://yanmarshop.com/en-GB/catalog/all/servicebom/yanmardata-1310808/yanmar-marine-marine-main-engine-medium-ay-series-6aym-wet-fig-37-air-cooler'
});
if (!sources.some(source=>source.id==='D05-74')) sources.unshift({
  id:'D05-74', title:'6AYM-WET · Katalog komponen Fig. 74 Fuel injection pump',status:'DOCUMENTED',
  url:'https://yanmarshop.com/en-GB/catalog/all/servicebom/yanmardata-1311509/yanmar-marine-marine-main-engine-medium-ay-series-6aym-wet-fig-74-fuel-injection-pump'
});
if (!sources.some(source=>source.id==='D05-79')) sources.unshift({
  id:'D05-79', title:'6AYM-WET · Katalog komponen Fig. 79 Fuel injection valve',status:'DOCUMENTED',
  url:'https://yanmarshop.com/en-GB/catalog/all/servicebom/yanmardata-1311833/yanmar-marine-marine-main-engine-medium-ay-series-6aym-wet-fig-79-fuel-injection-valve'
});
for (const [figure,title] of [[42,'Oil cooler'],[57,'Freshwater heat exchanger']]) {
  const catalog = await read(base+'doc/cooler-specialist/D05-'+figure+'.json').catch(error=>{
    if (error.code !== 'ENOENT') throw error;
    return null;
  });
  if (catalog && /^https:\/\//i.test(catalog.url) && !sources.some(source=>source.id==='D05-'+figure)) {
    sources.unshift({id:'D05-'+figure, title:'6AYM-WET · Katalog komponen Fig. '+figure+' '+title,
      status:'DOCUMENTED',url:catalog.url});
  }
}
const catalogue = await read('../assets/daftar-yanmar.json').catch(error=>{
  if (error.code !== 'ENOENT') throw error;
  return null;
});
const figureSources = Object.fromEntries((catalogue?.figures || [])
  .filter(entry=>entry.figure && /^https:\/\//i.test(entry.source))
  .map(entry=>[entry.figure,entry.source]));
const assemblies = {};
for (const file of await list(modelPath+'assemblies/')) {
  if (!file.endsWith('.json')) continue;
  const assembly = await read(modelPath+'assemblies/'+file);
  if (!assembly.id || !assembly.bagian) continue;
  assemblies[assembly.id] = {
    name:assembly.nama,
    content_name:assembly.content_name,
    cut_axis:assembly.cut_axis,
    cut_normal:assembly.cut_normal,
    parent:assembly.parent_rakitan || assembly.parent_assembly || assembly.parent,
    anchor:assembly.acuan?.object_ids?.[0],
    status:assembly.status,
    notes:assembly.notes || assembly.limits,
    source_refs:assembly.source_refs || assembly.sumber,
    view:assembly.diagram?.arah_pandang,
    parts:assembly.bagian.flatMap(part=>part.object_ids.map(id=>{
      const pose = part.posisi?.find(item=>item.object_id === id);
      return {id, part_number:part.nomor_oem, role:part.role || part.peran,
        function:part.function || part.fungsi,
        offset_m:pose?.arah.map(value=>value*pose.jarak_m) || [0,0,0]};
    }))
  };
}
for (const nested of Object.values(assemblies)) {
  const parent = assemblies[nested.parent];
  if (!parent || !nested.anchor) continue;
  const inside = new Set(nested.parts.map(part=>part.id));
  parent.parts = parent.parts.filter(part=>part.id===nested.anchor || !inside.has(part.id));
}
const systemFiles = await list(modelPath+'systems/');
const systemOrder = ['fuel','lubrication','freshwater','seawater','intake-exhaust','air-exhaust','air_exhaust'];
const systems = [];
for (const key of systemOrder) {
  const filename = key+'.json';
  if (!systemFiles.includes(filename)) continue;
  const system = await read(modelPath+'systems/'+filename);
  systems.push(Object.fromEntries(['system','status','applicability','nodes','edges','gaps'].map(name=>[name,system[name]])));
}
const fields = ['id','name','nama','assembly','parent','rakitan','status','source_refs','quantity','count','jumlah',
  'part_number','nomor_oem','function','fungsi','note','notes','xray_shell','xray_content','node','direction'];
const components = [...exterior.components,...internal.components].map(component =>
  Object.fromEntries(fields.filter(name=>name in component).map(name=>[name,component[name]])));
const componentIds=new Set(components.map(({id})=>id));
coverage.by_object=Object.fromEntries(Object.entries(coverage.by_object).filter(([id])=>componentIds.has(id)));
const aliases = Object.fromEntries(Object.entries({
  'EXT-COOLING-07':'EXT-COOLING-302',
  'INT-TIMING-09':'EXT-COOLING-26',
  'INT-TIMING-06':'EXT-COOLING-41'
}).filter(([oldId,id])=>!componentIds.has(oldId) && componentIds.has(id)));

const drivetrain = await read(modelPath+'motion/drivetrain.json').catch(error=>{
  if (error.code !== 'ENOENT') throw error;
  return {groups:[],stationary:[],gaps:[]};
});
const drivenNodes=new Set((drivetrain.groups || []).flatMap(group=>group.targets || []));
const viewer = {
  enabled:Boolean(kinematics.cylinders?.length === 6),
  rotators:[kinematics.crank_root,'EXT-FLYWHEEL-02','EXT-FRONT-02','EXT-FLYWHEEL-20']
    .filter(node=>!drivenNodes.has(node) && (node!=='EXT-FLYWHEEL-20' || componentIds.has(node)))
    .map(node=>({node,factor:kinematics.crank_signed_rotation_ratio})).concat(kinematics.cam_root && !drivenNodes.has(kinematics.cam_root)
      ? [{node:kinematics.cam_root,factor:kinematics.cam_signed_rotation_ratio}] : []),
  valves:kinematics.valve_train || [],
  throw_m:kinematics.throw_m, rod_cc_m:kinematics.rod_center_to_center_m,
  firing_order:kinematics.firing_order,
  cylinder_centers:kinematics.cylinder_center_x_m,
  combustion_y:(datum.dimensions.deck_y?.value || .49)-.03,
  cylinders:kinematics.cylinders.map(({rod_root,piston_root,crankpin_phase_deg})=>
    ({rod:rod_root,piston:piston_root,phase_deg:crankpin_phase_deg}))
};
const inspectionLinks = {
  'RAK-BLOCK':['RAK-INT-LINER','RAK-INT-PISTON','RAK-INT-ROD','RAK-INT-CRANK'],
  'RAK-HEADS':['RAK-INT-VALVE','RAK-INT-CAM','RAK-INT-FUELINJ'],
  'RAK-FRONT':['RAK-INT-TIMING'],
  'RAK-OILPAN':['RAK-INT-OILPUMP']
};
const flows = await read(modelPath+'flow/routes.json').catch(error=>{
  if (error.code !== 'ENOENT') throw error;
  return {ports:[],routes:[],gaps:[]};
});
const filmPath='assets/film/yanmar-6aym-r05.mp4';
const comparisonPath='assets/perbandingan-filter.jpg';
const driveAuditPath='assets/audit-gerak.txt';
const present=path=>access(new URL('../'+path,import.meta.url)).then(()=>path,()=>null);
const [film,comparison,driveAudit]=await Promise.all([present(filmPath),present(comparisonPath),present(driveAuditPath)]);
const extrema = ['x','z','y'].map(axis=>datum.dimensions['physical_drawn_'+axis+'_span'].value);
await Promise.all(['exterior','internal'].map(name=>copyFile(
  new URL(modelPath+name+'/'+name+'.glb',import.meta.url),
  new URL('../assets/'+name+'.glb',import.meta.url))));
const plates = ['injector-legend.html','injector-section.webp','injector-exploded.webp','injector-section-exploded.pdf'];
const platesOutput = new URL('../assets/injector-plates/',import.meta.url);
await mkdir(platesOutput,{recursive:true});
await Promise.all(plates.map(file=>copyFile(new URL(modelPath+'internal/plates/'+file,import.meta.url),
  new URL(file,platesOutput))));
await writeFile(new URL('../assets/data.json',import.meta.url),
  JSON.stringify({revision:'r05',reviewApproved:false,components,aliases,sources,figureSources,assemblies,coverage,inspectionLinks,systems,flows,drivetrain,film,comparison,driveAudit,kinematics:{status:kinematics.status,viewer},extrema}));
