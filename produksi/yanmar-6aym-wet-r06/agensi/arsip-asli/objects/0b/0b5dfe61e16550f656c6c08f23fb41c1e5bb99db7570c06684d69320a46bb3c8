def volute(p, rad, thick, mat, flip=False):
    rings=[]
    for i in range(37):
        t=i/36
        angle=(-.53+t*2*pi) * (-1 if flip else 1)
        center_radius=rad*(.52+.11*t)
        center=Vector((p[0],p[1]+center_radius*cos(angle),p[2]+center_radius*sin(angle)))
        tube=rad*(.21+.17*t)
        rings.append([center+Vector((thick*cos(j*pi/8)*(0.64+.36*t),tube*sin(j*pi/8)*cos(angle),
                                     tube*sin(j*pi/8)*sin(angle))) for j in range(16)])
    return polygon_loft(rings,mat,0)

