      item.append(detail);
      list.append(item);
    }
    body.append(list);
    if (graph.gaps?.length) {
      const details = element('details');
      details.append(element('summary','Batas verifikasi'));
      for (const gap of graph.gaps) details.append(element('p', gap));
      body.append(details);
    }
  });
}
